# Keep Linux entrypoints runnable in Windows/WSL checkouts.
*.sh text eol=lf
**/gradlew text eol=lf
infra/bin/* text eol=lf
infra/bin/lib/* text eol=lf
*.bash text eol=lf
*.sql  text eol=lf
# Shell tooling reads image names from YAML; CRLF must not become part of a tag.
*.yml text eol=lf
*.yaml text eol=lf
infra/host/entry/* text eol=lf
**/Dockerfile* text eol=lf
**/.dockerignore text eol=lf
# Byte-hashed service policies must keep the same bytes on Windows and Linux.
backend/realtime-activity/src/main/resources/service-policy/*.txt text eol=lf
