{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/child-request.schema.json",
  "title": "아이 정보 입력",
  "description": "POST는 displayName과 birthDate 필수. PATCH는 바꿀 필드만. 생년월일은 최초 등록일 기준 만 6세 이상~만 13세 미만. 평년의 2/29 생일은 3/1로 계산. 등록 후 나이 증가로 이용을 막지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "interests": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10
      }
    },
    "birthDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
