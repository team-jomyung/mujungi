{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/event-payloads.schema.json",
  "title": "영속 이벤트 6종 payload",
  "description": "계약 6절 C11 이벤트 payload. 받는 쪽은 모르는 필드를 무시하고 모르는 enum 값은 '알 수 없음'으로 처리한다(BR5.9). 이 스키마는 보내는 쪽 형식이다. 더하기만 한 필드: DeviceStatusChanged.guardianId(편차 (q)).",
  "$defs": {
    "SessionStateChanged": {
      "description": "Realtime(U4, U1 슬라이스) 발행 · Core 사본(U4) · U7 구독. statusVersion은 세션별 단조 증가이고 받는 쪽은 자기 값보다 작거나 같으면 버린다(BR5.10)",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "guardianId", "status", "statusVersion", "at"],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "guardianId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "childId": { "$ref": "common.schema.json#/$defs/NullableUuid" },
        "activityType": { "$ref": "common.schema.json#/$defs/ActivityType" },
        "status": {
          "type": "string",
          "enum": [
            "PREPARING",
            "DEVICE_ACK",
            "WAITING_CHILD",
            "ACTIVE",
            "CLOSING",
            "ENDED",
            "ENDED_UNCONFIRMED",
            "ABORTED",
            "DECLINED",
            "FAILED"
          ]
        },
        "statusVersion": { "type": "integer", "minimum": 1 },
        "endReason": { "$ref": "common.schema.json#/$defs/NullableEndReason" },
        "failureCode": { "$ref": "common.schema.json#/$defs/NullableFailureCode" },
        "confirmed": { "type": "boolean" },
        "technicalPause": { "$ref": "common.schema.json#/$defs/TechnicalPause" },
        "at": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "SessionRecordCaptured": {
      "description": "U4 발행(종료 상태에서 한 번, 다시 보내도 같은 snapshotHash) · U4 ActivityRecord 구독. U1은 생산하지 않고 전달 틀 · 재무장(A1) · 삭제 참가자의 payload 비우기(BR5.14)만 다룬다. 대화 원문을 담으므로 전달 뒤 payload를 비운다(BR5.11)",
      "type": "object",
      "required": ["sessionId", "guardianId", "childId", "activityType", "finalStatus", "snapshotId", "snapshotHash"],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "guardianId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "childId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "activityType": { "$ref": "common.schema.json#/$defs/ActivityType" },
        "finalStatus": { "type": "string", "enum": ["ENDED", "ENDED_UNCONFIRMED", "ABORTED", "DECLINED", "FAILED"] },
        "endReason": { "type": ["string", "null"] },
        "confirmed": { "type": "boolean" },
        "startedAt": { "$ref": "common.schema.json#/$defs/NullableDateTime" },
        "endedAt": { "$ref": "common.schema.json#/$defs/NullableDateTime" },
        "termination": { "type": ["object", "null"] },
        "snapshotId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "snapshotVersion": { "type": "integer" },
        "snapshotHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "record": { "type": ["object", "null"] }
      }
    },
    "DeviceStatusChanged": {
      "description": "Realtime(U3, U1 슬라이스) 발행 · Core DeviceRegistry 사본 · U7 구독. 상태가 바뀔 때만 쓰고 받는 쪽은 봉투 occurredAt으로 최신만 반영한다(편차 (g) · BR4.1). guardianId는 선택 필드로 더했고 Inbox 행의 guardian_id 원천이다(편차 (q) · A4)",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "state", "since"],
      "properties": {
        "deviceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "state": { "$ref": "common.schema.json#/$defs/ConnectionState" },
        "rttMs": { "type": ["integer", "null"], "minimum": 0 },
        "recentDisconnects": { "type": ["integer", "null"], "minimum": 0 },
        "since": { "$ref": "common.schema.json#/$defs/DateTime" },
        "lastSeenAt": { "$ref": "common.schema.json#/$defs/NullableDateTime" },
        "guardianId": { "$ref": "common.schema.json#/$defs/NullableUuid" }
      }
    },
    "DeletionCompleted": {
      "description": "Realtime 발행(U4가 Realtime 쪽 참가자를 모두 돌린 뒤) · U2 AccountDeletion 구독. 제어 이벤트라 FAILED여도 재무장한다(A1)",
      "type": "object",
      "additionalProperties": false,
      "required": ["deletionRequestId", "guardianId", "completedAt"],
      "properties": {
        "deletionRequestId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "guardianId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "completedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "counts": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "sessions": { "type": "integer", "minimum": 0 },
            "transcripts": { "type": "integer", "minimum": 0 },
            "audioFiles": { "type": "integer", "minimum": 0 },
            "practiceRecords": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "DeviceReleased": {
      "description": "Core DeviceRegistry 발행(재등록 BR2.5 · 계정 삭제 BR2.10) · Realtime DeviceGateway 구독(4401로 닫고 OFFLINE, BR3.8). 제어 이벤트라 FAILED여도 재무장한다(A1)",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "reason"],
      "properties": {
        "deviceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "guardianId": { "$ref": "common.schema.json#/$defs/NullableUuid" },
        "reason": { "type": "string", "enum": ["REREGISTERED", "ACCOUNT_DELETED"] }
      }
    },
    "DeletionRequested": {
      "description": "U2 AccountDeletion 발행 · U4 SessionLifecycle 구독(Realtime 쪽 삭제 지휘). U1은 전달 틀과 Realtime 메시징 참가자(BR5.14)만 다룬다. 제어 이벤트라 FAILED여도 재무장한다(A1)",
      "type": "object",
      "additionalProperties": false,
      "required": ["deletionRequestId", "guardianId", "requestedAt"],
      "properties": {
        "deletionRequestId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "guardianId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "childId": { "$ref": "common.schema.json#/$defs/NullableUuid" },
        "requestedAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    }
  }
}
