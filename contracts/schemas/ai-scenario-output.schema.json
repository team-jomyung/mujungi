{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/ai-scenario-output.schema.json",
  "title": "연습 장면 대본 생성 출력(Luna 구조화 출력)",
  "description": "core 상황 생성(U10)이 Luna에 요청하는 생성 응답 모양(계약 요약 C-DS5 · C-DS1 scenes). 상대 역할 지시(partnerRole)는 모델에 받지 않고 Core 고정 역할 지시로 만든다(ai-io.md 7절 U5a-J22, Contract Design 검토 R-04). 재시도는 REQUEST_BOUNDED(ai-io.md 10절). 생성물은 제브로 보내지 않는다(FR2.6). [U8 편차 (U8-a)]",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sceneKey",
          "sceneKind",
          "sceneDescription",
          "partnerOpener",
          "opportunitySentence",
          "reexplanation",
          "expressionFrames",
          "relation",
          "place",
          "topic"
        ],
        "properties": {
          "sceneKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
          "sceneKind": { "enum": ["BASE", "VARIANT"] },
          "sceneDescription": {
            "description": "무중이 역할 밖에서 아이에게 들려주는 장면 설명(1 ~ 3문장, 상황 사실만, 정답 · 핵심 단서 · 상대 속마음 설명 없음, 기회 문장 · opportunityCondition을 옮겨 쓰지 않음). VARIANT는 변형 제안 때 들린다(서버가 '이어서 해 볼까?'를 붙임). 아이 이름은 '아이'로 치환된 값 [U10 편차 (U10-c)]",
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "partnerOpener": {
            "description": "친구 역할의 첫 대사 한 마디(설명 뒤, 기회 문장 앞). BASE는 비어 있지 않아야 하고(서버 검사), VARIANT는 빈 문자열이다(변형 제안 수락 뒤 친구가 기회 문장으로 바로 시작). 아이 이름은 '아이'로 치환된 값 [U10 편차 (U10-c)]",
            "type": "string",
            "maxLength": 300
          },
          "opportunitySentence": {
            "description": "기회 문장: 친구 역할이 실제로 하는 대사(단서가 이 대사 속에서 귀로 들림, 무대 지문 · 해설 아님, 세션 동안 고정). 아이 이름은 '아이'로 치환된 값 [U10 편차 (U10-c)]",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reexplanation": {
            "description": "무중의 상황 다시 설명(FR4.3, 무슨 일이 있었는지 더 쉽게, 기회 문장은 뒤에 다시 들리므로 담지 않음). 아이 이름은 '아이'로 치환된 값",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "focusPoints": {
            "description": "집중 연습 요점(코치 역할에서만 쓴다)",
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "expressionExamples": {
            "description": "표현 예시. 코치 역할 · 동의 뒤에만 쓴다(FR4.4)",
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "expressionFrames": {
            "description": "빈칸 예문(생성 판 v7부터 필수 칸). expressionExamples와 같은 순서 · 같은 개수로, 각 예시에서 아이가 채워야 할 핵심 내용 낱말 자리를 '뭐뭐'로 비운다(꾸밈말 하나만 비우지 않음). 코치의 첫 도움이 글자 그대로 말하고, 코치 역할 · 동의 뒤에만 쓴다. 예시가 없으면 빈 배열 [U10 편차 (U10-e)]",
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "relation": { "type": "string", "minLength": 1, "maxLength": 200 },
          "place": { "type": "string", "minLength": 1, "maxLength": 200 },
          "topic": { "type": "string", "minLength": 1, "maxLength": 200 },
          "preservation": {
            "description": "그래프 경로의 보존 정보. participants · relationship · situation은 변형 계획 좌표라 서버 어휘(VariantPlanner.PARTICIPANTS · KnowledgeSeed.RELATIONSHIPS · KnowledgeSeed.SITUATIONS)만 받는다. relationship은 장면 relation(목표 상대, 자유 문자열)과 다른 값이다. [U10 편차 (U10-b)]",
            "type": "object", "additionalProperties": false,
            "required": ["skillRef", "invariantSentence", "preservationRule", "transferDistance", "changedElement", "participants", "situation", "relationship"],
            "properties": {
              "skillRef": {"type": "string", "minLength": 1, "maxLength": 200},
              "invariantSentence": {"type": "string", "minLength": 1, "maxLength": 2000},
              "preservationRule": {"type": "string", "minLength": 1, "maxLength": 2000},
              "transferDistance": {"enum": ["SAME_CONTEXT", "NEAR"]},
              "changedElement": {"enum": ["topic", "place", "participants", "relationship", "situation"]},
              "participants": {"enum": ["아이와 또래", "아이와 모둠원", "아이와 친구"]},
              "situation": {"enum": ["CLUB", "FAMILY", "FRIEND_PRIVATE", "SCHOOL_GROUP"]},
              "relationship": {"enum": ["CLASSMATE", "CLUB_JUNIOR", "CLUB_PEER", "CLUB_SENIOR", "FAMILY", "FRIEND_CASUAL", "FRIEND_CLOSE", "TEACHER", "TEAMMATE"]}
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "scenes": [
        {
          "sceneKey": "base-1",
          "sceneKind": "BASE",
          "sceneDescription": "무중이랑 블록 놀이를 한다고 생각해 보자. 무중이가 친구야. 너는 탑 꼭대기에 올릴 빨간 블록이 필요한데, 빨간 블록은 무중이한테 다 있어.",
          "partnerOpener": "나는 빨간 블록으로 성을 쌓고 있어.",
          "opportunitySentence": "이것 봐, 높지?",
          "reexplanation": "너는 빨간 블록이 하나 필요해. 빨간 블록은 친구한테 다 있어.",
          "focusPoints": ["친구 물건을 쓰고 싶을 때는 하고 싶은 걸 말하고 물어보면 돼"],
          "expressionExamples": ["나도 블록 하나 써도 돼?"],
          "expressionFrames": ["나도 뭐뭐 하나 써도 돼?"],
          "relation": "FRIEND_CLOSE",
          "place": "HOME",
          "topic": "블록 놀이"
        }
      ]
    },
    {
      "scenes": [
        {
          "sceneKey": "base-1",
          "sceneKind": "BASE",
          "sceneDescription": "무중이랑 교실에서 블록 탑을 쌓는다고 생각해 보자. 무중이가 같은 반 친구야. 둘이서 한참 동안 탑을 쌓았어.",
          "partnerOpener": "휴, 오래 했다.",
          "opportunitySentence": "나 이제 그만할래.",
          "reexplanation": "너랑 친구가 교실에서 오래 블록 탑을 쌓았어.",
          "expressionFrames": [],
          "relation": "같은 반 친구",
          "place": "교실",
          "topic": "놀이",
          "preservation": {
            "skillRef": "seed:S1",
            "invariantSentence": "친구가 멈추려 한다",
            "preservationRule": "의도를 유지한다",
            "transferDistance": "SAME_CONTEXT",
            "changedElement": "topic",
            "participants": "아이와 친구",
            "situation": "SCHOOL_GROUP",
            "relationship": "CLASSMATE"
          }
        }
      ]
    }
  ]
}
