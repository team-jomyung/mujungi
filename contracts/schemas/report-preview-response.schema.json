{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/report-preview-response.schema.json",
  "title": "28 리포트 범위 미리보기",
  "description": "GET /api/reports/preview?from&to 200(계약 3절 C5 · U6 BR9.1). 활동 = 기간 안의 ENDED · ENDED_UNCONFIRMED · ABORTED와 정리 대상인 재시작 FAILED(편차 (U6-b)), 정리 상태와 관계없이 넣는다. date는 26과 같은 줄 시각(startedAt, 없으면 사본 요청 시각)의 Asia/Seoul 날짜다. firstRecordDate는 같은 조건의 활동 전체 중 첫날(없으면 null).",
  "type": "object",
  "additionalProperties": false,
  "required": ["firstRecordDate", "activities"],
  "properties": {
    "firstRecordDate": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "type": "null" }
      ]
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "date", "activityType", "startedAt"],
        "properties": {
          "sessionId": { "$ref": "common.schema.json#/$defs/Uuid" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "activityType": { "$ref": "common.schema.json#/$defs/ActivityType" },
          "startedAt": { "$ref": "common.schema.json#/$defs/NullableDateTime" }
        }
      }
    }
  }
}
