{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/session-result-response.schema.json",
  "title": "27 결과 · 생활 팁 · 목표 후보",
  "description": "GET /api/sessions/{sessionId}/result 200. U14 새 연습 결과는 실제 timing과 가변 양수 sceneNo를 보존하고, 27 칩만 기존5종으로 접는다. value/rationale/live/differs/4요소/skillRef/배경/매칭로그/pending은 공개하지 않는다. 새 후보는 displayEvidence를 공개하고 내부 reasonText는 공개하지 않는다. 레거시 후보의 기존 reasonText 계약은 유지한다. strict 이전 소비자와 같은 릴리스에서 갱신한다(U14-b).",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobStatus", "sentences", "tips", "candidates"],
  "properties": {
    "jobStatus": { "$ref": "#/$defs/JobStatus" },
    "resultLevel": {
      "anyOf": [
        { "type": "string", "enum": ["FULL", "PARTIAL", "INSUFFICIENT"] },
        { "type": "null" }
      ]
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "goalSelectionId": { "$ref": "common.schema.json#/$defs/NullableUuid" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "practice": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["goals"],
          "properties": {
            "goals": {
              "type": "array",
              "items": { "$ref": "#/$defs/PracticeGoal" }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["supportItemId", "condition", "content", "limitation"],
        "properties": {
          "supportItemId": { "$ref": "common.schema.json#/$defs/Uuid" },
          "title": { "type": "string", "minLength": 1 },
          "condition": { "type": "string" },
          "content": { "type": "string", "minLength": 1 },
          "limitation": { "type": "string" }
        }
      }
    },
    "noTipReason": {
      "anyOf": [
        { "type": "string", "enum": ["NEED_MORE_OBSERVATION"] },
        { "type": "null" }
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recommendationId", "displayName", "evidence", "selected"],
        "oneOf": [
          { "required": ["reasonText"], "not": { "required": ["displayEvidence"] } },
          { "required": ["displayEvidence"], "not": { "required": ["reasonText"] } }
        ],
        "properties": {
          "recommendationId": { "$ref": "common.schema.json#/$defs/Uuid" },
          "displayName": { "type": "string", "minLength": 1 },
          "reasonText": { "type": "string" },
          "displayEvidence": { "type": "string", "minLength": 1, "maxLength": 40 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["utteranceSeq", "kind"],
              "properties": {
                "utteranceSeq": { "type": "integer", "minimum": 1 },
                "kind": { "type": "string", "enum": ["CHILD_RECALL", "GUARDIAN_INPUT"] }
              }
            }
          },
          "selected": { "type": "boolean" },
          "goalSelectionId": { "$ref": "common.schema.json#/$defs/NullableUuid" }
        }
      }
    }
  },
  "$defs": {
    "JobStatus": {
      "description": "세션 정리 작업 상태(BR1.11 · BR8.3). NONE = 정리 대상이 아님(DECLINED · 발화 0건 · 기록이 오지 않는 세션)",
      "type": "string",
      "enum": ["NONE", "REQUESTED", "RUNNING", "DONE", "FAILED"]
    },
    "PracticeGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalSelectionId", "displayName", "order", "scenes", "help"],
      "properties": {
        "goalSelectionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "displayName": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sceneNo", "exposureType", "sceneChip", "chipText"],
            "properties": {
              "sceneNo": { "type": "integer", "minimum": 1 },
              "timing": { "type": ["string", "null"], "enum": ["IMMEDIATE", "AFTER_REASK", "AFTER_HELP", null] },
              "exposureType": { "type": "string", "enum": ["ORIGINAL", "NEW_SCENARIO"] },
              "sceneChip": {
                "type": "string",
                "enum": ["DONE_IMMEDIATE", "DONE_AFTER_HELP", "NEXT_TIME", "ON_HOLD", "NOT_DONE"]
              },
              "chipText": { "type": "string", "minLength": 1 },
              "notDoneReason": {
                "anyOf": [
                  { "type": "string", "enum": ["TIME_OVER", "SCENARIO_FAILED", "ACTIVITY_ENDED", "NO_RESPONSE"] },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "help": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "consent"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "consent": { "type": "string", "enum": ["ACCEPTED", "DECLINED", "NO_RESPONSE", "NONE"] }
          }
        }
      }
    }
  }
}
