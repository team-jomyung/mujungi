{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/device-register-response.schema.json",
  "title": "05a 코드 등록 응답",
  "description": "POST /api/device/register 201(BR2.7). 같은 보호자의 재시도는 첫 성공과 같은 201이다(편차 (m)). 해시 · 토큰은 없다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "codePrefix", "registeredAt"],
  "properties": {
    "deviceId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "codePrefix": { "$ref": "common.schema.json#/$defs/CodePrefix" },
    "registeredAt": { "$ref": "common.schema.json#/$defs/DateTime" }
  }
}
