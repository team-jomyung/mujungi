{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/ai-goal-candidate-output.schema.json",
  "title": "목표 후보 출력(Luna 구조화 출력)",
  "description": "core 결과 작업(U14)이 Luna에 요청하는 목표 후보 모양(계약 요약 C-DS6, ai-io.md 6.8 U6 초안을 대체). 4요소 속성 이름은 U14 Functional Design에서 확정한다(계약 요약 열린 질문 2). 재시도는 JOB_ATTEMPT(ai-io.md 10절). 근거 인용은 서버가 저장 전사와 대조한다. [U8 편차 (U8-a)]",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "assessment"],
  "properties": {
    "candidates": {
      "description": "서로 다른 지원 필요마다 하나(편차 FT-1029-b, 이전 최대 3개). 개수 상한(8개) · 후보 칸 글자 수 · 근거 유무는 계약이 아니라 서버 검사(GoalCandidateValidator)가 후보마다 본다. 후보 하나가 어겨도 출력 전체를 버리지 않고 그 후보만 뺀다",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "indicator",
          "displayName",
          "targetExpression",
          "fourElements",
          "skillRef",
          "reasonText",
          "evidence",
          "displayEvidence"
        ],
        "properties": {
          "indicator": {
            "description": "후보가 다루는 화용 지표 코드(FT-1029-b). P1 응답 · P2 정보 충분성 · P3 화제 관리 · P4 수정 · 명료화 · P5 상대 · 관계 맞춤 · U5 상대 관점",
            "enum": ["P1", "P2", "P3", "P4", "P5", "U5"]
          },
          "displayName": { "type": "string", "minLength": 1 },
          "targetExpression": { "type": "string", "minLength": 1 },
          "fourElements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["situation", "partner", "intent", "expression"],
            "properties": {
              "situation": { "type": "string", "minLength": 1 },
              "partner": { "type": "string", "minLength": 1 },
              "intent": { "type": "string", "minLength": 1 },
              "expression": { "type": "string", "minLength": 1 }
            }
          },
          "skillRef": {
            "description": "씨앗 요약 목록의 id 또는 NONE(FR8.2)",
            "type": "string",
            "minLength": 1
          },
          "reasonText": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["utteranceSeq", "quote"],
              "properties": {
                "utteranceSeq": { "type": "integer", "minimum": 1 },
                "quote": {
                  "description": "저장 전사 글자 그대로의 인용. 아이 이름은 '아이'로 치환된 값",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "displayEvidence": { "type": "string", "minLength": 1 },
          "structureSignature": {
            "description": "U14 내부 씨앗 연결용 선택 추상화. 원문/식별자를 복사하지 않는다. 없으면 NONE 유지.",
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["targetSkill", "requiredInference", "perspectiveStructure", "decidableByEvidence", "directCheckAllowed"],
            "properties": {
              "targetSkill": { "enum": ["RECOGNIZE", "PRODUCE", "REPAIR"] },
              "requiredInference": { "type": "string", "minLength": 1 },
              "perspectiveStructure": { "enum": ["상대의 의도 1층", "상대의 지식 상태 1층", "상대가 나를 어떻게 봤을지 2층"] },
              "decidableByEvidence": { "enum": ["YES", "NO"] },
              "directCheckAllowed": { "enum": ["YES", "NO"] }
            }
          }
        }
      }
    },
    "assessment": {
      "description": "화용 지표별 관찰 판정(FT-1029-b). 여섯 지표를 한 번씩. 점수가 아니라 후보를 고르기 위한 관찰 기록이다",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indicator", "rating"],
        "properties": {
          "indicator": { "enum": ["P1", "P2", "P3", "P4", "P5", "U5"] },
          "rating": { "enum": ["NEED", "OK", "NOT_OBSERVED"] }
        }
      }
    }
  },
  "examples": [
    {
      "candidates": [
        {
          "indicator": "P2",
          "displayName": "물건 빌려 달라기",
          "targetExpression": "필요한 것과 이유를 말하며 빌려 달라고 하기",
          "fourElements": {
            "situation": "친구가 가진 물건이 필요할 때",
            "partner": "친한 친구",
            "intent": "물건을 잠깐 빌리고 싶다",
            "expression": "필요한 것과 이유를 함께 말한다"
          },
          "skillRef": "NONE",
          "reasonText": "블록 놀이에서 필요한 것을 짧게만 말한 장면이 있었어요.",
          "evidence": [ { "utteranceSeq": 31, "quote": "그거 줘." } ],
          "displayEvidence": "블록 놀이 장면"
        }
      ],
      "assessment": [
        { "indicator": "P1", "rating": "OK" },
        { "indicator": "P2", "rating": "NEED" },
        { "indicator": "P3", "rating": "OK" },
        { "indicator": "P4", "rating": "NOT_OBSERVED" },
        { "indicator": "P5", "rating": "NOT_OBSERVED" },
        { "indicator": "U5", "rating": "OK" }
      ]
    }
  ]
}
