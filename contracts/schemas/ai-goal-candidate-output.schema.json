{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/ai-goal-candidate-output.schema.json",
  "title": "목표 후보 출력(Luna 구조화 출력)",
  "description": "core 결과 작업(U14)이 Luna에 요청하는 목표 후보 모양(계약 요약 C-DS6, ai-io.md 6.8 U6 초안을 대체). 4요소 속성 이름은 U14 Functional Design에서 확정한다(계약 요약 열린 질문 2). 재시도는 JOB_ATTEMPT(ai-io.md 10절). 근거 인용은 서버가 저장 전사와 대조한다. [U8 편차 (U8-a)]",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "description": "최대 3개(AC4.5.7 기본값, 설정 mujoong.goal.max-candidates)",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "targetExpression",
          "fourElements",
          "skillRef",
          "reasonText",
          "evidence",
          "displayEvidence"
        ],
        "properties": {
          "displayName": { "type": "string", "minLength": 1, "maxLength": 12 },
          "targetExpression": { "type": "string", "minLength": 1, "maxLength": 200 },
          "fourElements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["situation", "partner", "intent", "expression"],
            "properties": {
              "situation": { "type": "string", "minLength": 1, "maxLength": 500 },
              "partner": { "type": "string", "minLength": 1, "maxLength": 200 },
              "intent": { "type": "string", "minLength": 1, "maxLength": 500 },
              "expression": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          },
          "skillRef": {
            "description": "씨앗 요약 목록의 id 또는 NONE(FR8.2)",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reasonText": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["utteranceSeq", "quote"],
              "properties": {
                "utteranceSeq": { "type": "integer", "minimum": 1 },
                "quote": {
                  "description": "저장 전사 글자 그대로의 인용. 아이 이름은 '아이'로 치환된 값",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "displayEvidence": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  },
  "examples": [
    {
      "candidates": [
        {
          "displayName": "물건 빌려 달라기",
          "targetExpression": "필요한 것과 이유를 말하며 빌려 달라고 하기",
          "fourElements": {
            "situation": "친구가 가진 물건이 필요할 때",
            "partner": "친한 친구",
            "intent": "물건을 잠깐 빌리고 싶다",
            "expression": "필요한 것과 이유를 함께 말한다"
          },
          "skillRef": "NONE",
          "reasonText": "블록 놀이에서 필요한 것을 짧게만 말한 장면이 있었어요.",
          "evidence": [ { "utteranceSeq": 31, "quote": "그거 줘." } ],
          "displayEvidence": "블록 놀이 장면"
        }
      ]
    }
  ]
}
