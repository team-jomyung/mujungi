{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/internal-session-start-request.schema.json",
  "title": "세션 시작 명령(세션 패키지)",
  "description": "POST /internal/sessions 요청 본문(계약 5절 C8 · BR6.5). sessionId는 Core가 발급한다(J11). childContext는 대화 역할용 최소 문맥 세 필드뿐이고 08 입력 네 칸 원문 · 보호자 연락처는 넣지 않는다(NFR3.1 · SD-20). 선택 conversationGuide는 원문 없는 주제 코드와 정보 출처이며 자유대화에서만 사용한다. U1 자유대화의 stopExpressions는 기본 종료 표현 한 건(isDefault true), approvedContent는 CLOSING · WAITING_FILLER, practice는 null이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "idempotencyKey",
    "guardianId",
    "childId",
    "deviceId",
    "activityType",
    "consentSnapshot",
    "childContext",
    "stopExpressions",
    "approvedContent"
  ],
  "allOf": [{"if": {"properties": {"activityType": {"const": "PRACTICE"}}}, "then": {"not": {"required": ["conversationGuide"]}}}],
  "properties": {
    "sessionId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "idempotencyKey": { "$ref": "common.schema.json#/$defs/Uuid" },
    "guardianId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "childId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "deviceId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "activityType": { "$ref": "common.schema.json#/$defs/ActivityType" },
    "consentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyVersion", "voiceAndText", "guardianView", "reportSharing", "rawAudio"],
      "properties": {
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 20 },
        "voiceAndText": { "type": "boolean" },
        "guardianView": { "type": "boolean" },
        "reportSharing": { "type": "boolean" },
        "rawAudio": { "type": "boolean" }
      }
    },
    "conversationGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "sourceType"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "FRIEND",
              "SCHOOL",
              "FAMILY",
              "ACADEMY",
              "BLOCKS",
              "DRAWING",
              "SPORTS",
              "DINOSAURS",
              "PLAY",
              "DAILY"
            ]
          }
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "SEEN",
            "HEARD_FROM_CHILD",
            "UNSPECIFIED"
          ]
        }
      }
    },
    "childContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "age", "interests"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 10 },
        "age": { "type": "integer", "minimum": 6 },
        "interests": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 20 }
        }
      }
    },
    "stopExpressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "isDefault"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 20 },
          "isDefault": { "type": "boolean" }
        }
      }
    },
    "approvedContent": {
      "type": "object",
      "required": ["CLOSING", "WAITING_FILLER"],
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentVersionId", "text", "audioUrl"],
        "properties": {
          "contentVersionId": { "$ref": "common.schema.json#/$defs/Uuid" },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 },
          "audioUrl": { "$ref": "common.schema.json#/$defs/ApprovedAudioUrl" }
        }
      }
    },
    "approvedSpeech": {
      "description": "음성 파일 없는 승인 발화(content_type APPROVED_SPEECH, U8 · BR1.2). 선택 속성이고 없으면 빈 것으로 본다. 각 code의 APPROVED 최고 판을 세션에 고정한다(BR1.3). 한 code는 approvedContent와 approvedSpeech 중 하나에만 들어간다(스키마로 막지 못해 Core 조립 시험 · Realtime 수신 검사가 확인). [U8 편차 (U8-b)]",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentVersionId", "text"],
        "properties": {
          "contentVersionId": { "$ref": "common.schema.json#/$defs/Uuid" },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "practice": {
      "description": "U5 확장 자리. U1 자유대화에서는 null이다. 판정 기준은 판정 역할에만 쓰고 공급자 요청에는 넣지 않는다(NFR3.2 · SD-20)",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "goals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "goalSelectionId": { "$ref": "common.schema.json#/$defs/Uuid" },
                  "order": { "type": "integer" },
                  "displayName": { "type": "string" },
                  "behaviorKey": { "type": "string" },
                  "behaviorVersion": { "type": "integer" },
                  "judgmentCriteria": { "type": "string" },
                  "firstScenario": { "type": ["object", "null"] }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    }
  }
}
