{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/common.schema.json",
  "title": "공통 형식",
  "description": "여러 스키마가 함께 쓰는 형식(계약 2절 · 4.2절 · 6절, BR8.10). 상태 · 사유 이름은 화면 설계 그대로다. 받는 쪽은 모르는 enum 값을 '알 수 없음'으로 처리하고 오류로 끊지 않는다(계약 10절). 이 스키마의 enum은 보내는 쪽(U1 구현)이 지켜야 하는 값이다.",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "NullableUuid": {
      "anyOf": [
        { "$ref": "#/$defs/Uuid" },
        { "type": "null" }
      ]
    },
    "DateTime": {
      "description": "ISO 8601 UTC(끝 Z). 예 2026-10-15T09:00:00Z, 소수 초는 밀리초까지(BR8.10)",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "NullableDateTime": {
      "anyOf": [
        { "$ref": "#/$defs/DateTime" },
        { "type": "null" }
      ]
    },
    "TraceId": {
      "description": "32자 소문자 16진수(OD-7). 형식이 틀리면 받는 쪽이 새로 만든다",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "RegistrationCode": {
      "description": "등록 코드 8자, 알파벳 2~9 · A~Z에서 I · L · O를 뺀 31글자(BR1.1 · J22)",
      "type": "string",
      "pattern": "^[2-9A-HJKMNP-Z]{8}$"
    },
    "CodePrefix": {
      "description": "등록 코드 앞 4글자(BR2.7)",
      "type": "string",
      "pattern": "^[2-9A-HJKMNP-Z]{4}$"
    },
    "ActivityType": {
      "type": "string",
      "enum": ["FREE_TALK", "PRACTICE"]
    },
    "SessionStatus": {
      "description": "세션 상태 11개(K5). REQUESTED는 Core 사본에만 있다(BR6.8)",
      "type": "string",
      "enum": [
        "REQUESTED",
        "PREPARING",
        "DEVICE_ACK",
        "WAITING_CHILD",
        "ACTIVE",
        "CLOSING",
        "ENDED",
        "ENDED_UNCONFIRMED",
        "ABORTED",
        "DECLINED",
        "FAILED"
      ]
    },
    "EndReason": {
      "type": "string",
      "enum": [
        "GUARDIAN_STOP",
        "CHILD_STOP",
        "SILENCE",
        "DISCONNECT",
        "CONSENT_WITHDRAWN",
        "UNCONFIRMED",
        "DECLINED",
        "FAILED"
      ]
    },
    "NullableEndReason": {
      "anyOf": [
        { "$ref": "#/$defs/EndReason" },
        { "type": "null" }
      ]
    },
    "FailureCode": {
      "type": "string",
      "enum": ["DEVICE_NO_ACK", "SCENARIO_GEN_FAILED", "PROVIDER_UNAVAILABLE", "SERVER_RESTART"]
    },
    "NullableFailureCode": {
      "anyOf": [
        { "$ref": "#/$defs/FailureCode" },
        { "type": "null" }
      ]
    },
    "ConnectionState": {
      "description": "기기 연결 원장(Realtime) 상태. U1은 OFFLINE · CONNECTED · DISCONNECTED · UNRESPONSIVE를 쓰고 UNSTABLE 판정은 U3가 완성한다(BR4.8)",
      "type": "string",
      "enum": ["OFFLINE", "CONNECTED", "UNSTABLE", "DISCONNECTED", "UNRESPONSIVE"]
    },
    "TechnicalPause": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "since"],
          "properties": {
            "kind": { "type": "string", "enum": ["DEVICE", "PROVIDER"] },
            "since": { "$ref": "#/$defs/DateTime" }
          }
        },
        { "type": "null" }
      ]
    },
    "ApprovedAudioUrl": {
      "description": "승인 음성 정적 경로(같은 origin 상대 경로, 개인정보 없음). 플랜 충돌 13 · J30",
      "type": "string",
      "pattern": "^/media/approved/[A-Za-z0-9._-]+\\.wav$"
    }
  }
}
