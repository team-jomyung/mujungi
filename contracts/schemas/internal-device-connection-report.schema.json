{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/internal-device-connection-report.schema.json",
  "title": "기기 연결 상태 주기 보고",
  "description": "PUT /internal/devices/{deviceId}/connection 본문(계약 5절 C9 · BR4.1 · BR4.8). state와 reportedAt은 필수이고 없으면 400 INVALID_ENVELOPE다(편차 (i)). reportedAt은 그 보고가 담은 연결 행을 읽은 Realtime 시각이다. 나머지 필드가 없으면 Core는 기존 값을 유지한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "reportedAt"],
  "properties": {
    "state": { "$ref": "common.schema.json#/$defs/ConnectionState" },
    "rttMs": { "type": ["integer", "null"], "minimum": 0 },
    "recentDisconnects": { "type": ["integer", "null"], "minimum": 0 },
    "since": { "$ref": "common.schema.json#/$defs/NullableDateTime" },
    "lastSeenAt": { "$ref": "common.schema.json#/$defs/NullableDateTime" },
    "reportedAt": { "$ref": "common.schema.json#/$defs/DateTime" }
  }
}
