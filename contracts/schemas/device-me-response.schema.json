{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/device-me-response.schema.json",
  "title": "기기 등록 확인 응답",
  "description": "GET /api/device/me 200(BR3.5). 아이 정보는 주지 않는다. 응답과 함께 MUJOONG_DEVICE 쿠키 Max-Age를 다시 400일로 늘린다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "registeredAt"],
  "properties": {
    "deviceId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "registeredAt": { "$ref": "common.schema.json#/$defs/DateTime" }
  }
}
