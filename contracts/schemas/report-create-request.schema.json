{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/report-create-request.schema.json",
  "title": "28 「활동 N개로 리포트 만들기」 요청",
  "description": "POST /api/reports 본문(계약 3절 C5 · U6 BR9.2). from ≤ to ≤ 오늘(Asia/Seoul), sessionIds는 1개 이상 · 중복 없음 · 모두 그 보호자의 미리보기 조건 안 활동이어야 한다. 같은 idempotencyKey는 첫 결과, 다른 본문은 409 IDEMPOTENCY_CONFLICT.",
  "type": "object",
  "additionalProperties": true,
  "required": ["from", "to", "sessionIds", "idempotencyKey"],
  "properties": {
    "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sessionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Uuid" }
    },
    "idempotencyKey": { "$ref": "common.schema.json#/$defs/Uuid" }
  }
}
