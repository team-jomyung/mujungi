{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/admin-cost-detail-response.schema.json",
  "title": "관리자 비용 상세 응답(JIRA-280). 항목의 전체 기간",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "activityId",
    "childName",
    "type",
    "category",
    "purpose",
    "observedAt",
    "status",
    "voiceSeconds",
    "inputTokens",
    "outputTokens",
    "estimatedUsd",
    "phases",
    "scope"
  ],
  "properties": {
    "id": {
      "description": "활동 · 준비 id 또는 연결 미확인 호출 id",
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "activityId": {
      "$ref": "common.schema.json#/$defs/NullableUuid"
    },
    "childName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "type": {
      "enum": [
        "FREE_TALK",
        "PRACTICE",
        null
      ]
    },
    "category": {
      "description": "ACTIVITY, FAILED_TO_START(활동 행 없는 연습 준비), NON_ACTIVITY(지금 수집 구조에는 없음), UNLINKED(보호자 연결 없는 Core 호출)",
      "enum": [
        "ACTIVITY",
        "FAILED_TO_START",
        "NON_ACTIVITY",
        "UNLINKED"
      ]
    },
    "purpose": {
      "type": "string",
      "maxLength": 60
    },
    "observedAt": {
      "description": "마지막 호출 완료 시각(사용량이 없으면 활동 시각)",
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "status": {
      "$ref": "admin-common.schema.json#/$defs/CollectionStatus"
    },
    "voiceSeconds": {
      "description": "아는 값의 합(표시용)",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "inputTokens": {
      "description": "아는 값의 합(표시용). 금액은 입력 · 출력을 모두 아는 호출만 계산한다",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "outputTokens": {
      "description": "아는 값의 합(표시용)",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "estimatedUsd": {
      "$ref": "admin-common.schema.json#/$defs/NullableUsd"
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "admin-common.schema.json#/$defs/CostPhase"
      }
    },
    "scope": {
      "type": "string",
      "maxLength": 400
    }
  }
}
