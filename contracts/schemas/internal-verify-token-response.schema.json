{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/internal-verify-token-response.schema.json",
  "title": "기기 토큰 확인 응답",
  "description": "POST /internal/devices/verify-token 200(BR3.4). 결과는 그 WSS 연결 하나에만 묶고 캐시하지 않는다(편차 (j)). 보호자에게 아이가 아직 없으면 childId는 null이다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "guardianId", "childId", "registrationStatus"],
  "properties": {
    "deviceId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "guardianId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "childId": { "$ref": "common.schema.json#/$defs/NullableUuid" },
    "registrationStatus": { "type": "string", "enum": ["REGISTERED"] }
  }
}
