{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/practice-scenario.schema.json",
  "type": "object",
  "required": [
    "scenarioId",
    "kind",
    "relationType",
    "opportunityCondition",
    "scenarioText",
    "partnerRoleText",
    "triggerScript",
    "validation"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "ORIGINAL",
        "NEW_SCENARIO"
      ]
    },
    "relationType": {
      "type": "string",
      "minLength": 1
    },
    "opportunityCondition": {
      "type": "string",
      "minLength": 1
    },
    "scenarioText": {
      "type": "string",
      "minLength": 1
    },
    "partnerRoleText": {
      "type": "string",
      "minLength": 1
    },
    "triggerScript": {
      "type": "string",
      "minLength": 1
    },
    "scriptVersion": {"type": "string", "const": "scenario-script.v1"},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sceneKey", "sceneKind", "sceneDescription", "opportunitySentence", "reexplanation", "partnerRole"], "properties": {"sceneDescription": {"description": "무중이 역할 밖에서 들려주는 장면 설명(생성 판 v6부터 기회 조건 · 기회 문장을 옮겨 쓰지 않는다). realtime 도입은 이 원문을 자르지 않고 그대로 재생한다. 친구 첫 대사가 없는 옛 대본에서 설명이 기회 문장으로 끝나고 끝까지 재생했으면 OPPORTUNITY 진입에서 기회 문장을 다시 재생하지 않는다. VARIANT 설명은 변형 제안 때 들린다 [U12 편차 (U12-c)] [U10 편차 (U10-c)]"}, "partnerOpener": {"type": "string", "maxLength": 300, "description": "친구 역할의 첫 대사(선택, 생성 판 v6부터). realtime은 설명 → 첫 대사 → 기회 문장 순서로 재생하고, 없거나 비었으면 설명 뒤 곧바로 기회 문장이다(옛 대본 · VARIANT) [U10 편차 (U10-c)]"}, "opportunitySentence": {"description": "기회 문장. 생성 판 v6부터 친구 역할의 실제 대사이고 단서가 이 대사 속에서 귀로 들린다 [U10 편차 (U10-c)]"}, "partnerRole": {"type": "string", "minLength": 1, "maxLength": 20, "description": "상대 역할 이름(짧은 명사구, 예: 친한 친구). 지시문이 아니다. core가 장면 relation에서 만들고(대체값 친구), 금지 규칙은 realtime 고정 지시가 맡는다 [U12 편차 (U12-b)]"}, "expressionFrames": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 500}, "description": "빈칸 예문(선택, 생성 판 v7부터). expressionExamples와 같은 순서 · 같은 개수로 핵심 내용 낱말 자리를 '뭐뭐'로 비운 말이다. 코치 전용(도움 동의 뒤에만 들림). realtime 코치 첫 도움이 글자 그대로 말하고, 없으면(옛 대본) GPT-Live가 예시에서 비운다 [U10 편차 (U10-e)]"}}, "additionalProperties": true}},
    "selfReview": {"type": "object", "required": ["verdict", "model", "promptVersion"], "properties": {"verdict": {"const": "APPROVE"}, "model": {"type": "string", "minLength": 1}, "promptVersion": {"enum": ["scenario-review.v1", "scenario-review.v2", "scenario-review.v3", "scenario-review.v4", "scenario-review.v5"]}}, "additionalProperties": false},
    "generation": {"type": "object", "required": ["model", "promptVersion", "graphContextUsed", "calls"], "properties": {"model": {"type": "string", "minLength": 1}, "promptVersion": {"enum": ["scenario-generation.v2", "scenario-generation.v3", "scenario-generation.v4", "scenario-generation.v5", "scenario-generation.v6", "scenario-generation.v7"]}, "graphContextUsed": {"type": "boolean"}, "calls": {"type": "integer", "minimum": 2, "maximum": 6}, "kgVersion": {"type": ["string", "null"], "minLength": 1}, "basePreservation": {"enum": ["BASE_REPLACED", "BASE_ONLY_EARLIER_REVIEW", "BASE_ONLY_REVIEWED", null], "description": "보존 BASE를 어떻게 썼는가(선택, 없으면 생성 · 검토한 그대로 발급). BASE_REPLACED: 다음 생성이 고쳐 쓴 BASE를 단독 승인된 BASE로 되돌려 변형과 함께 검토 · 발급, BASE_ONLY_EARLIER_REVIEW: 변형을 빼고 단독 승인된 BASE를 추가 검토 없이 발급(검토 입력이 같다), BASE_ONLY_REVIEWED: 변형을 빼고 BASE만 다시 검토해 발급 [U10 편차 (U10-d)]"}}, "additionalProperties": false},
    "validation": {
      "type": "object",
      "required": [
        "goalIncluded",
        "triggerIncluded",
        "forbiddenFound"
      ],
      "properties": {
        "goalIncluded": {
          "const": true
        },
        "triggerIncluded": {
          "const": true
        },
        "forbiddenFound": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
