{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/practice-scenario.schema.json",
  "type": "object",
  "required": [
    "scenarioId",
    "kind",
    "relationType",
    "opportunityCondition",
    "scenarioText",
    "partnerRoleText",
    "triggerScript",
    "validation"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "ORIGINAL",
        "NEW_SCENARIO"
      ]
    },
    "relationType": {
      "type": "string",
      "minLength": 1
    },
    "opportunityCondition": {
      "type": "string",
      "minLength": 1
    },
    "scenarioText": {
      "type": "string",
      "minLength": 1
    },
    "partnerRoleText": {
      "type": "string",
      "minLength": 1
    },
    "triggerScript": {
      "type": "string",
      "minLength": 1
    },
    "scriptVersion": {"type": "string", "const": "scenario-script.v1"},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sceneKey", "sceneKind", "sceneDescription", "opportunitySentence", "reexplanation", "partnerRole"], "additionalProperties": true}},
    "selfReview": {"type": "object", "required": ["verdict", "model", "promptVersion"], "properties": {"verdict": {"const": "APPROVE"}, "model": {"type": "string", "minLength": 1}, "promptVersion": {"enum": ["scenario-review.v1", "scenario-review.v2", "scenario-review.v3", "scenario-review.v4"]}}, "additionalProperties": false},
    "generation": {"type": "object", "required": ["model", "promptVersion", "graphContextUsed", "calls"], "properties": {"model": {"type": "string", "minLength": 1}, "promptVersion": {"enum": ["scenario-generation.v2", "scenario-generation.v3", "scenario-generation.v4", "scenario-generation.v5"]}, "graphContextUsed": {"type": "boolean"}, "calls": {"type": "integer", "minimum": 2, "maximum": 6}, "kgVersion": {"type": ["string", "null"], "minLength": 1}}, "additionalProperties": false},
    "validation": {
      "type": "object",
      "required": [
        "goalIncluded",
        "triggerIncluded",
        "forbiddenFound"
      ],
      "properties": {
        "goalIncluded": {
          "const": true
        },
        "triggerIncluded": {
          "const": true
        },
        "forbiddenFound": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
