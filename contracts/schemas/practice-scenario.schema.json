{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/practice-scenario.schema.json",
  "type": "object",
  "required": [
    "scenarioId",
    "kind",
    "relationType",
    "opportunityCondition",
    "scenarioText",
    "partnerRoleText",
    "triggerScript",
    "validation"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "ORIGINAL",
        "NEW_SCENARIO"
      ]
    },
    "relationType": {
      "type": "string",
      "minLength": 1
    },
    "opportunityCondition": {
      "type": "string",
      "minLength": 1
    },
    "scenarioText": {
      "type": "string",
      "minLength": 1
    },
    "partnerRoleText": {
      "type": "string",
      "minLength": 1
    },
    "triggerScript": {
      "type": "string",
      "minLength": 1
    },
    "scriptVersion": {"type": "string", "const": "scenario-script.v1"},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sceneKey", "sceneKind", "sceneDescription", "opportunitySentence", "reexplanation", "partnerRole"], "properties": {"sceneDescription": {"description": "장면 설명. BASE는 기회 조건과 기회 문장(opportunitySentence)을 포함한다(core 규칙). realtime 도입은 이 원문을 자르지 않고 그대로 재생하며, 기회 문장을 담았고 끝까지 재생했으면 OPPORTUNITY 진입에서 기회 문장을 다시 재생하지 않는다 [U12 편차 (U12-c)]"}, "partnerRole": {"type": "string", "minLength": 1, "maxLength": 20, "description": "상대 역할 이름(짧은 명사구, 예: 친한 친구). 지시문이 아니다. core가 장면 relation에서 만들고(대체값 친구), 금지 규칙은 realtime 고정 지시가 맡는다 [U12 편차 (U12-b)]"}}, "additionalProperties": true}},
    "selfReview": {"type": "object", "required": ["verdict", "model", "promptVersion"], "properties": {"verdict": {"const": "APPROVE"}, "model": {"type": "string", "minLength": 1}, "promptVersion": {"const": "scenario-review.v1"}}, "additionalProperties": false},
    "generation": {"type": "object", "required": ["model", "promptVersion", "graphContextUsed", "calls"], "properties": {"model": {"type": "string", "minLength": 1}, "promptVersion": {"enum": ["scenario-generation.v2", "scenario-generation.v3"]}, "graphContextUsed": {"type": "boolean"}, "calls": {"type": "integer", "minimum": 2, "maximum": 6}, "kgVersion": {"type": ["string", "null"], "minLength": 1}}, "additionalProperties": false},
    "validation": {
      "type": "object",
      "required": [
        "goalIncluded",
        "triggerIncluded",
        "forbiddenFound"
      ],
      "properties": {
        "goalIncluded": {
          "const": true
        },
        "triggerIncluded": {
          "const": true
        },
        "forbiddenFound": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
