{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujoong.invalid/contracts/schemas/ai-seed-output.schema.json",
  "title": "새 씨앗 출력",
  "description": "U15 v2: GENERATED/DUPLICATE/NONE 분기. outcome 없는 기존 2필드 모양은 U9 호환 검증용으로만 유지하고 U15는 성공 생성으로 수락하지 않는다.",
  "examples": [
    {
      "skillName": "보여 주는 것에 반응하기",
      "invariantSentence": "상대가 자기가 만든 걸 보여 줬는데 아무 말 없이 내 할 일만 했다"
    },
    {
      "outcome": "DUPLICATE",
      "duplicate_of": "seed:S1"
    },
    {
      "outcome": "NONE",
      "none_reason": "NO_VALID_SEED"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "skillName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "invariantSentence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "outcome": {
      "type": "string",
      "enum": [
        "GENERATED",
        "DUPLICATE",
        "NONE"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_skill",
        "required_inference",
        "perspective_structure",
        "decidable_by_evidence",
        "direct_check_allowed"
      ],
      "properties": {
        "target_skill": {
          "enum": [
            "RECOGNIZE",
            "PRODUCE",
            "REPAIR"
          ],
          "type": "string"
        },
        "required_inference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "perspective_structure": {
          "type": "string",
          "enum": [
            "상대의 의도 1층",
            "상대의 지식 상태 1층",
            "상대가 나를 어떻게 봤을지 2층"
          ]
        },
        "decidable_by_evidence": {
          "type": "string",
          "enum": [
            "YES",
            "NO"
          ]
        },
        "direct_check_allowed": {
          "type": "string",
          "enum": [
            "YES",
            "NO"
          ]
        }
      }
    },
    "family": {
      "type": "string",
      "enum": [
        "indirect_meaning",
        "listener_knowledge",
        "information_quantity",
        "repair_clarification",
        "topic_management",
        "reciprocity_responsiveness",
        "listener_relationship_adaptation",
        "OTHER"
      ]
    },
    "preservationRule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "relationship": {
      "type": "string",
      "enum": [
        "FRIEND_CLOSE",
        "FRIEND_CASUAL",
        "CLASSMATE",
        "CLUB_PEER",
        "CLUB_SENIOR",
        "CLUB_JUNIOR",
        "TEAMMATE",
        "TEACHER",
        "FAMILY"
      ]
    },
    "situation": {
      "type": "string",
      "enum": [
        "FRIEND_PRIVATE",
        "SCHOOL_GROUP",
        "CLUB",
        "FAMILY"
      ]
    },
    "misreadCost": {
      "type": "string",
      "const": "LOW"
    },
    "recoverable": {
      "type": "boolean",
      "const": true
    },
    "duplicate_of": {
      "type": "string",
      "pattern": "^seed:(S[1-9][0-9]*|X[1-9][0-9]*|G[0-9]{4,})$"
    },
    "none_reason": {
      "type": "string",
      "enum": [
        "NO_VALID_SEED",
        "UNSAFE_CONTENT",
        "INSUFFICIENT_CONTEXT"
      ]
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skillName",
            "invariantSentence"
          ],
          "properties": {
            "skillName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "invariantSentence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "skillName",
            "invariantSentence",
            "signature",
            "family",
            "preservationRule",
            "relationship",
            "situation",
            "misreadCost",
            "recoverable"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "const": "GENERATED"
            },
            "skillName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "invariantSentence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "signature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target_skill",
                "required_inference",
                "perspective_structure",
                "decidable_by_evidence",
                "direct_check_allowed"
              ],
              "properties": {
                "target_skill": {
                  "enum": [
                    "RECOGNIZE",
                    "PRODUCE",
                    "REPAIR"
                  ],
                  "type": "string"
                },
                "required_inference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "perspective_structure": {
                  "type": "string",
                  "enum": [
                    "상대의 의도 1층",
                    "상대의 지식 상태 1층",
                    "상대가 나를 어떻게 봤을지 2층"
                  ]
                },
                "decidable_by_evidence": {
                  "type": "string",
                  "enum": [
                    "YES",
                    "NO"
                  ]
                },
                "direct_check_allowed": {
                  "type": "string",
                  "enum": [
                    "YES",
                    "NO"
                  ]
                }
              }
            },
            "family": {
              "type": "string",
              "enum": [
                "indirect_meaning",
                "listener_knowledge",
                "information_quantity",
                "repair_clarification",
                "topic_management",
                "reciprocity_responsiveness",
                "listener_relationship_adaptation",
                "OTHER"
              ]
            },
            "preservationRule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "relationship": {
              "type": "string",
              "enum": [
                "FRIEND_CLOSE",
                "FRIEND_CASUAL",
                "CLASSMATE",
                "CLUB_PEER",
                "CLUB_SENIOR",
                "CLUB_JUNIOR",
                "TEAMMATE",
                "TEACHER",
                "FAMILY"
              ]
            },
            "situation": {
              "type": "string",
              "enum": [
                "FRIEND_PRIVATE",
                "SCHOOL_GROUP",
                "CLUB",
                "FAMILY"
              ]
            },
            "misreadCost": {
              "type": "string",
              "const": "LOW"
            },
            "recoverable": {
              "type": "boolean",
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "duplicate_of"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "const": "DUPLICATE"
            },
            "duplicate_of": {
              "type": "string",
              "pattern": "^seed:(S[1-9][0-9]*|X[1-9][0-9]*|G[0-9]{4,})$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "none_reason"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "const": "NONE"
            },
            "none_reason": {
              "type": "string",
              "enum": [
                "NO_VALID_SEED",
                "UNSAFE_CONTENT",
                "INSUFFICIENT_CONTEXT"
              ]
            }
          }
        }
      ]
    }
  ]
}
