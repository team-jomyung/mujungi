# 무중 릴리스 값 템플릿 (U1 3.5 Step 44 · cicd 2.3.1 · infra-spec 4.2 · J134)
#
# infra/ci/build-images.sh가 이 파일을 렌더해 인프라 번들 이미지(mujoong-infra)의 /bundle/release.env로 넣는다.
# 배포 D3이 번들을 /opt/mujoong/releases/<SHA>/에 꺼내고 Compose가 `--env-file <릴리스>/release.env`로 읽어
# compose.demo.yml 이미지 이름의 레지스트리 · 태그 변수를 채운다. 롤백은 직전 릴리스의 이 파일을 쓰므로 태그도 함께 되돌아간다.
# 비밀이 아닌 값만 둔다(레지스트리 이름 · 태그 = 커밋 SHA · 소스 지문). 비밀은 /opt/mujoong/env/<서비스>.env에만 있다(infra-spec 3.7).
# 템플릿 변수는 아래 네 개뿐이다(render.sh가 이름을 명시해 바꾸고, 남은 토큰이 있으면 실패한다).
MUJOONG_REGISTRY=${MUJOONG_REGISTRY}
MUJOONG_TAG=${MUJOONG_TAG}
MUJOONG_GIT_SHA=${MUJOONG_GIT_SHA}
MUJOONG_SOURCE_FINGERPRINT=${MUJOONG_SOURCE_FINGERPRINT}
