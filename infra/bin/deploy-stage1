#!/usr/bin/env bash
# deploy-stage1 — 배포 1단계: D1 시작 기록 · D2 백업 · D3 대상 번들 꺼내기 (U1 3.5 Step 47 · cicd 2.6.1 · 2.8 · 2.10 · 2.11 ·
# infra-spec 4.2 · 4.5.4 · R4-8 · J92 · J99 · J128)
#
# 고정 진입점 /opt/mujoong/bin/deploy.sh(infra/host/entry/deploy.sh)가 현재 릴리스(/opt/mujoong/current)의 이 스크립트를 부른다.
# 부르는 곳: SSM 문서 mujoong-deploy(CI, trigger=CI runId=none J128) · SSM 세션의 사람(trigger=MANUAL).
# 두 단계 진입(cicd 2.6.1 · 다르게 푼 곳 13): 이 스크립트(현재 릴리스)가 잠금 · 백업 · 대상 번들 꺼내기를 하고, 대상 릴리스에 든
# deploy-apply가 D3의 나머지(대상 기준 준비)와 D4 ~ D9를 한다. 그래서 대상 SHA의 Compose 파일 · 스크립트가 서로 맞고, 롤백은
# 옛 릴리스의 스크립트가 옛 Compose를 다룬다.
#   D1  호스트 잠금(flock 비차단, 이미 배포 중이면 종료 코드 75로 끝내고 기록하지 않음) → 거부 조건(측정 창 스택 mujoong-lt 실행 중 ·
#       mujoong-compose 단위 정지 · 서비스당 컨테이너 2개 이상 · deploy.log를 쓸 수 없음, 종료 코드 3, 기록하지 않음) →
#       배포 id(<UTC>-<SHA 앞 7자>) · 직전 성공 SHA → DEPLOY_START 한 줄
#   D2  (DEPLOY만) backup-trigger --trigger deploy. 실패하면 중단(복원 지점이 없다, 구 버전 유지)
#   D3  GHCR 로그인(파라미터 GHCR_PULL_TOKEN이 있을 때만: 임시 DOCKER_CONFIG, 토큰은 파이프로 --password-stdin, set +x, 끝나면 지움, J99)
#       → 번들 이미지 <레지스트리>/mujoong-infra:<SHA> pull → 라벨 SHA 확인 → /opt/mujoong/releases/<SHA>/에 꺼내기(임시 폴더 →
#       이름 변경, 같은 SHA 폴더가 온전하면 재사용) → 대상 릴리스의 bin/deploy-apply로 넘긴다
# 실패 기록: 어떤 단계에서 끝나든(신호 포함) deploy.log에 같은 배포 id의 DEPLOY_END가 없으면 이 스크립트가 FAIL · ABORTED로 쓴다.
# 표준 출력: 마지막 줄이 DEPLOY_END 한 줄(SSM 출력 길이 제한 때문에 단계별 상세는 /var/log/mujoong/deploy-<배포 id>.log, cicd 2.10 ⑥).
# 값(비밀 · 토큰)은 어디에도 출력하지 않는다.
#
# 쓰는 법: deploy-stage1 --sha <40자 소문자 16진수> --mode DEPLOY|ROLLBACK [--trigger CI|MANUAL] [--run-id <번호>|none]
# 종료 코드: 0 성공, 1 배포 실패(DEPLOY_END result=FAIL), 3 거부 조건, 64 인자 오류, 66 현재 릴리스 없음(최초 설치는 RUNBOOK),
#           75 이미 배포 중, 77 root가 아님, 130 · 143 신호(ABORTED)

set -Eeuo pipefail
set +x
umask 027

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/bin/lib/host.sh
. "$SCRIPT_DIR/lib/host.sh"
readonly PARAM_PATH=/mujoong/demo/

sha=""
mode=""
trigger=MANUAL
run_id=none
while [ "$#" -gt 0 ]; do
  case "$1" in
    --sha) sha="${2:-}"; shift ;;
    --mode) mode="${2:-}"; shift ;;
    --trigger) trigger="${2:-}"; shift ;;
    --run-id) run_id="${2:-}"; shift ;;
    -h | --help) sed -n '2,29p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "deploy-stage1: 모르는 인자: $1" >&2; exit 64 ;;
  esac
  shift
done
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "deploy-stage1: --sha는 40자 소문자 16진수다" >&2; exit 64; }
case "$mode" in DEPLOY | ROLLBACK) ;; *) echo "deploy-stage1: --mode는 DEPLOY 또는 ROLLBACK이다" >&2; exit 64 ;; esac
case "$trigger" in CI | MANUAL) ;; *) echo "deploy-stage1: --trigger는 CI 또는 MANUAL이다" >&2; exit 64 ;; esac
[[ "$run_id" =~ ^([0-9]{1,20}|none)$ ]] || { echo "deploy-stage1: --run-id는 숫자 또는 none이다" >&2; exit 64; }
if [ "$(id -u)" -ne 0 ]; then
  echo "deploy-stage1: root로 실행해야 한다(SSM Run Command · sudo)" >&2
  exit 77
fi

current="$MUJOONG_OPT/current"
if [ ! -f "$current/release.env" ] || [ ! -f "$current/compose.demo.yml" ]; then
  echo "deploy-stage1: 현재 릴리스($current)가 없다 — 최초 설치는 RUNBOOK 4.5.1 절차로 한다(cicd 2.11)" >&2
  exit 66
fi

# ---- D1 잠금과 거부 조건(기록하지 않는다) -----------------------------------------------------------------
reject() {
  echo "deploy-stage1: 거부: $1" >&2
  exit 3
}
mkdir -p "$MUJOONG_LOG_DIR" "$MUJOONG_LOG_DIR/archive" "$MUJOONG_OPT/releases"
exec 9>"$MUJOONG_OPT/.deploy.lock"
if ! flock -n 9; then
  echo "deploy-stage1: 이미 배포 중이다(호스트 잠금)" >&2
  exit 75
fi
if ! touch "$MUJOONG_LOG_DIR/deploy.log" 2>/dev/null || [ ! -w "$MUJOONG_LOG_DIR/deploy.log" ] \
  || [ "$(df -Pk "$MUJOONG_LOG_DIR" | awk 'NR == 2 { print $4 }')" -lt 1024 ]; then
  reject "deploy.log를 쓸 수 없다(디스크 · 권한, cicd 2.10 ③)"
fi
docker info >/dev/null 2>&1 || reject "docker 데몬에 닿지 않는다"
if [ -n "$(docker ps -q --filter label=com.docker.compose.project=mujoong-lt 2>/dev/null)" ]; then
  reject "측정 창 스택 mujoong-lt가 실행 중이다(AUTO_DEPLOY 동결을 확인한다, infra-spec 1.3)"
fi
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl is-active --quiet mujoong-compose.service || reject "mujoong-compose 단위가 정지 상태다(서버 정지 · 측정 창)"
fi
dup="$(docker ps -a --filter "label=com.docker.compose.project=$MUJOONG_PROJECT" --format '{{.Label "com.docker.compose.service"}}' \
  | sort | uniq -d | paste -sd, -)"
[ -z "$dup" ] || reject "서비스당 컨테이너가 2개 이상이다($dup, NFR7.4)"

# ---- D1 시작 기록 -----------------------------------------------------------------------------------
started="$(mujoong_epoch)"
deploy_id="$(date -u -d "@$started" +%Y%m%dT%H%M%SZ)-${sha:0:7}"
step_log="$MUJOONG_LOG_DIR/deploy-$deploy_id.log"
state_file="$MUJOONG_OPT/.deploy-state"

# 직전 성공 SHA: deploy.log(회전된 것 포함, 새 것부터)의 마지막 DEPLOY_END result=OK → 없으면 last-ok(최초 설치가 남김) → none
last_ok_sha() {
  local f found rotated=()
  mapfile -t rotated < <(find "$MUJOONG_LOG_DIR" -maxdepth 1 -type f -name 'deploy.log.*' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | cut -d' ' -f2-)
  for f in "$MUJOONG_LOG_DIR/deploy.log" "${rotated[@]}"; do
    [ -r "$f" ] || continue
    found="$(gzip -dcf "$f" 2>/dev/null | grep -E 'event=DEPLOY_END .*result=OK( |$)' | tail -n 1 \
      | sed -nE 's/.* sha=([0-9a-f]{40})( .*|$)/\1/p')"
    if [ -n "$found" ]; then
      echo "$found"
      return
    fi
  done
  found="$(head -n 1 "$MUJOONG_OPT/last-ok" 2>/dev/null || true)"
  if [[ "$found" =~ ^[0-9a-f]{40}$ ]]; then echo "$found"; else echo none; fi
}
prev_sha="$(last_ok_sha)"
: >"$step_log"
mujoong_deploy_log "event=DEPLOY_START deployId=$deploy_id sha=$sha prevSha=$prev_sha mode=$mode trigger=$trigger runId=$run_id"
printf '%s %s\n' "$deploy_id" D1 >"$state_file"
current_step=D1

# shellcheck disable=SC2317,SC2329  # trap(EXIT · INT · TERM)이 부른다(J345: 0.9.0 SC2317 · 0.10+ SC2329 오판)
ended() { grep -qE "event=DEPLOY_END deployId=$deploy_id( |$)" "$MUJOONG_LOG_DIR/deploy.log" 2>/dev/null; }
# write_end_fallback <FAIL|ABORTED> — deploy-apply가 끝 줄을 쓰지 못하고 끝났을 때만
# shellcheck disable=SC2317,SC2329  # trap(EXIT · INT · TERM)이 부른다(J345: 0.9.0 SC2317 · 0.10+ SC2329 오판)
write_end_fallback() {
  local step
  ended && return 0
  step="$(awk -v id="$deploy_id" '$1 == id { print $2 }' "$state_file" 2>/dev/null)"
  [ -n "$step" ] || step="$current_step"
  mujoong_deploy_log "event=DEPLOY_END deployId=$deploy_id sha=$sha result=$1 failedStep=$step durationSec=$(($(mujoong_epoch) - started)) downtimeSec=NA deviceDownSec=NA budget=NA"
}
docker_config=""
# shellcheck disable=SC2317,SC2329  # trap(EXIT · INT · TERM)이 부른다(J345: 0.9.0 SC2317 · 0.10+ SC2329 오판)
on_exit() {
  local rc=$?
  trap - EXIT INT TERM
  [ -n "$docker_config" ] && rm -rf "$docker_config"
  if [ "$rc" -ne 0 ]; then
    write_end_fallback FAIL
  fi
  rm -f "$state_file"
  grep -E "event=DEPLOY_END deployId=$deploy_id( |$)" "$MUJOONG_LOG_DIR/deploy.log" 2>/dev/null | tail -n 1 || true
  exit "$rc"
}
# shellcheck disable=SC2317,SC2329  # trap(EXIT · INT · TERM)이 부른다(J345: 0.9.0 SC2317 · 0.10+ SC2329 오판)
on_signal() {
  trap - INT TERM
  write_end_fallback ABORTED
  exit "$1"
}
trap on_exit EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

step_ok() { mujoong_deploy_log "event=DEPLOY_STEP deployId=$deploy_id step=$1 result=OK durationSec=$2"; }
fail_step() { # <단계> <사유(값 없음)>
  echo "$(mujoong_now_iso) 실패 $1: $2" >>"$step_log"
  mujoong_deploy_log "event=DEPLOY_STEP deployId=$deploy_id step=$1 result=FAIL durationSec=$(($(mujoong_epoch) - step_started))"
  mujoong_deploy_log "event=DEPLOY_END deployId=$deploy_id sha=$sha result=FAIL failedStep=$1 durationSec=$(($(mujoong_epoch) - started)) downtimeSec=0 deviceDownSec=0 budget=OK"
  exit 1
}

# ---- D2 백업 한 번(DEPLOY만, 롤백은 건너뛴다 cicd 2.8.1 R3) -------------------------------------------------
if [ "$mode" = DEPLOY ]; then
  current_step=D2
  printf '%s %s\n' "$deploy_id" D2 >"$state_file"
  step_started="$(mujoong_epoch)"
  if "$SCRIPT_DIR/backup-trigger" --trigger deploy --timeout 300 --release "$current" >>"$step_log" 2>&1; then
    step_ok D2 $(($(mujoong_epoch) - step_started))
  else
    fail_step D2 "배포 직전 백업 실패(backup.log 참고)"
  fi
fi

# ---- D3 대상 번들 꺼내기 ---------------------------------------------------------------------------
current_step=D3
printf '%s %s\n' "$deploy_id" D3 >"$state_file"
step_started="$(mujoong_epoch)"
registry="$(mujoong_release_value "$current" MUJOONG_REGISTRY)" || fail_step D3 "현재 release.env에 MUJOONG_REGISTRY가 없다"
[[ "$registry" =~ ^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$ ]] || fail_step D3 "MUJOONG_REGISTRY 형식"
region="$(mujoong_aws_region)" || fail_step D3 "AWS 리전을 알 수 없다(AWS_REGION · 인스턴스 메타데이터)"

docker_config="$(mktemp -d)"
chmod 0700 "$docker_config"
export DOCKER_CONFIG="$docker_config"
ghcr_login() {
  local n user
  n="$(aws ssm get-parameters --region "$region" --names "${PARAM_PATH}GHCR_PULL_TOKEN" \
    --query 'length(Parameters)' --output text 2>>"$step_log")" || return 1
  if [ "$n" = 0 ]; then
    echo "$(mujoong_now_iso) GHCR_PULL_TOKEN 파라미터가 없다 — 공개 패키지로 보고 로그인하지 않는다(J99)" >>"$step_log"
    return 0
  fi
  user="$(aws ssm get-parameter --region "$region" --name "${PARAM_PATH}GHCR_PULL_USER" \
    --query Parameter.Value --output text 2>>"$step_log")" || return 1
  [[ "$user" =~ ^[A-Za-z0-9-]{1,39}$ ]] || return 1
  # 토큰은 변수 · 인자 · 파일에 두지 않고 파이프로만 넘긴다(cicd 2.5.2). 자격은 임시 DOCKER_CONFIG에만 남고 끝나면 지운다
  aws ssm get-parameter --region "$region" --name "${PARAM_PATH}GHCR_PULL_TOKEN" --with-decryption \
    --query Parameter.Value --output text 2>>"$step_log" \
    | docker login "${registry%%/*}" --username "$user" --password-stdin >>"$step_log" 2>&1
}
ghcr_login || fail_step D3 "GHCR 로그인 실패(파라미터 GHCR_PULL_TOKEN · GHCR_PULL_USER)"

bundle="$registry/mujoong-infra:$sha"
docker pull -q "$bundle" >>"$step_log" 2>&1 || fail_step D3 "번들 이미지 pull 실패($bundle)"
label="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$bundle" 2>/dev/null || true)"
[ "$label" = "$sha" ] || fail_step D3 "번들 이미지 라벨 SHA가 요청 SHA와 다르다"

release="$MUJOONG_OPT/releases/$sha"
complete_release() { # <폴더> — 같은 SHA의 온전한 릴리스인가
  [ -f "$1/compose.demo.yml" ] && [ -x "$1/bin/deploy-apply" ] \
    && [ "$(mujoong_release_value "$1" MUJOONG_GIT_SHA 2>/dev/null)" = "$sha" ] \
    && [ "$(mujoong_release_value "$1" MUJOONG_TAG 2>/dev/null)" = "$sha" ]
}
if complete_release "$release"; then
  echo "$(mujoong_now_iso) 릴리스 폴더 재사용: releases/$sha" >>"$step_log"
else
  tmp="$(mktemp -d "$MUJOONG_OPT/releases/.$sha.XXXXXX")"
  cid="$(docker create "$bundle" 2>>"$step_log")" || fail_step D3 "번들 컨테이너를 만들지 못했다"
  if ! docker cp "$cid:/bundle/." "$tmp/" >>"$step_log" 2>&1; then
    docker rm "$cid" >/dev/null 2>&1 || true
    rm -rf "$tmp"
    fail_step D3 "번들을 꺼내지 못했다"
  fi
  docker rm "$cid" >/dev/null 2>&1 || true
  chown -R root:root "$tmp"
  chmod -R go-w "$tmp"
  chmod 0755 "$tmp"
  if ! complete_release "$tmp"; then
    rm -rf "$tmp"
    fail_step D3 "꺼낸 번들이 온전하지 않다(release.env SHA · compose.demo.yml · bin/deploy-apply)"
  fi
  rm -rf "$release"
  mv -T "$tmp" "$release"
fi
target_registry="$(mujoong_release_value "$release" MUJOONG_REGISTRY)"
if [ "$target_registry" != "$registry" ]; then
  echo "$(mujoong_now_iso) 참고: 대상 레지스트리가 현재와 다르다(로그인은 현재 레지스트리 호스트로 했다)" >>"$step_log"
fi

# ---- 대상 릴리스로 넘긴다(D3 나머지 · D4 ~ D9) ------------------------------------------------------------
rc=0
"$release/bin/deploy-apply" --release "$release" --sha "$sha" --mode "$mode" --deploy-id "$deploy_id" \
  --prev-sha "$prev_sha" --started "$started" --d3-started "$step_started" || rc=$?
exit "$rc"
