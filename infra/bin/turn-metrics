#!/usr/bin/env bash
# turn-metrics — 한 턴 지연 로그로 NFR5.1 · 5.2 · 5.3(서버 몫)을 계산하는 점검 도우미 (U1 3.6 수정 라운드 · monitoring 2.3 · 2.8 · MO-4 ·
#                observability-design 2.8(OD-8) · 2.14 · NFR5.4 · J348)
#
# Realtime 로그의 LATENCY_TURN · SESSION_ITEMS_SERVED 줄만 읽는다(다른 원천 없음, 사람이 세지 않는다). 식은 observability-design 2.8이 정본이다.
#   [NFR5.1] 중계 증가분 = p95(relayInMs) + p95(relayOutMs). 목표 0.5초 이하, 경보선 0.4초(A-13). relayInMs는 턴의 p95라 그 분포의
#            p95로 근사한다(RD-3). 공급자 응답 길이 · 구간 확정 조용 시간은 넣지 않는다
#   [NFR5.2] 말 끝 → 기기 첫 음성 재생: t3 = tDevicePlayStart − clockOffsetMs, 합계 = t3 − tSpeechEnd. 목표 2.5초 이하, 경보선 2.0초.
#            clockOffsetMs가 없으면(CLOCK_OFFSET_MISSING) t3 = tDevicePlayStartRecv − rttMs ÷ 2로 추정하고 추정 수를 적는다. 오차 ± rttMs ÷ 2.
#            구간 p95: 첫 출력(tProviderFirstOut − tSpeechEnd) · 공급자 응답(providerResponseMs) · 조용 대기(quietWaitMs) ·
#            게이트(tGatePass − tSegmentConfirmed) · 첫 프레임(tFirstFrameSent − tGatePass) · 재생 시작(t3 − tGatePass)
#   [NFR5.3] 전사 확정 → 12 응답에 실릴 수 있게 된 시각(서버 몫) = tViewItemReady − tTranscriptFinal, speaker CHILD 행만.
#            목표 0.5초 이하, 경보선 0.4초. 폴링 몫(tViewItemFirstServed − tViewItemReady)은 참고로 따로 적는다
#   [미관측] 합계를 계산할 수 없는 턴(키 없음)의 비율과 unobservedReason별 건수. 0%가 아니면 사유를 표시한다
# 표본 규칙(monitoring 2.3 · RD-13): 100개 이상 p95, 10 ~ 99개 '목표 이내 비율 90% 이상', 10개 미만은 판정하지 않고 값 · 건수만(보류).
#   p95는 가장 가까운 순위(ceil(0.95 n)번째 작은 값)다. NFR5.1의 10 ~ 99 판정은 두 값이 다 있는 턴의 합(relayIn + relayOut)으로 센다(J348).
#   경보선은 판정한(보류 아닌) 지표의 p95와 비교한다.
#
# 입력(하나를 고른다)
#   기본               Realtime 컨테이너의 현재 로그 + 보존 폴더(/var/log/mujoong/archive, 시각순으로 이어서, monitoring 2.4.3)
#   --container-logs   합성 로그 디렉터리(<서비스>.log · archive/, 시험 · 리허설 — check-since-last와 같다)
#   --file <파일>      JSON 줄 파일(여러 번 가능, .gz 가능). 줄 앞의 docker 시각은 무시한다(3.6 실측 로그 build/b-and-t/PT-02/*.jsonl 등)
#   --since <ISO UTC>  이 시각 이후 줄만(기본 24시간 전). ts가 없는 줄(--file의 잘라 낸 줄)은 거르지 않는다
# 쓰는 법: turn-metrics [--since <ISO UTC>] [--container-logs <디렉터리> | --file <파일>...]
# 표준 출력: 지표마다 한 줄(시간 값 · 건수뿐, 전사 · id · 비밀 없음), 끝에 `SUMMARY turns=<n> nfr5.1=<판정> nfr5.2=<판정> nfr5.3=<판정> alerts=<목록>`
# 종료 코드: 0 미달 · 경보 없음(보류 포함), 1 미달 또는 경보선 초과(A-13), 2 전제 누락(jq · docker), 64 인자 오류

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/bin/lib/host.sh
. "$SCRIPT_DIR/lib/host.sh"

since=""
src=""
files=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --since) since="${2:-}"; shift ;;
    --container-logs) src="${2:-}"; shift ;;
    --file) files+=("${2:-}"); shift ;;
    -h | --help) sed -n '2,29p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "turn-metrics: 모르는 인자: $1" >&2; exit 64 ;;
  esac
  shift
done
if ! command -v jq >/dev/null 2>&1; then
  echo "turn-metrics: 전제 누락: jq" >&2
  exit 2
fi
if [ -n "$src" ] && [ "${#files[@]}" -gt 0 ]; then
  echo "turn-metrics: --container-logs와 --file은 함께 쓰지 않는다" >&2
  exit 64
fi
if [ -n "$src" ] && [ ! -d "$src" ]; then
  echo "turn-metrics: --container-logs 디렉터리가 없다" >&2
  exit 64
fi
for f in "${files[@]}"; do
  if [ -z "$f" ] || [ ! -r "$f" ]; then
    echo "turn-metrics: --file을 읽을 수 없다: ${f:-(빈 값)}" >&2
    exit 64
  fi
done
if [ -z "$src" ] && [ "${#files[@]}" -eq 0 ] && ! docker info >/dev/null 2>&1; then
  echo "turn-metrics: 전제 누락: docker" >&2
  exit 2
fi
[ -n "$since" ] || since="$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ)"
if ! [[ "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,9})?Z$ ]]; then
  echo "turn-metrics: since는 UTC ISO 8601(끝 Z)이다" >&2
  exit 64
fi
# 앱 로그 ts(밀리초)와 글자 순으로 비교할 수 있게 밀리초 꼴로 맞춘다
since_ms="${since%Z}"
if [[ "$since_ms" == *.* ]]; then since_ms="${since_ms%%.*}.$(printf '%-3.3s' "${since_ms#*.}" | tr ' ' 0)Z"; else since_ms="$since_ms.000Z"; fi

umask 077
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
if [ "${#files[@]}" -gt 0 ]; then
  for f in "${files[@]}"; do
    case "$f" in
      *.gz) gzip -dc "$f" ;;
      *) cat "$f" ;;
    esac
  done >"$work/raw"
  input_desc="파일 ${#files[@]}개"
else
  mujoong_collect_logs "$since" "$work" "$src"
  cp "$work/realtime.log" "$work/raw"
  input_desc="realtime 로그(${src:-현재 컨테이너}) + 보존 폴더"
fi

# 줄 앞 docker 시각 등 '{' 앞부분을 떼고 JSON으로 읽을 수 있는 두 사건 줄만 모은다
sed -n 's/^[^{]*{/{/p' "$work/raw" | jq -R -c --arg since "$since_ms" 'fromjson?
  | select(type == "object" and (.event == "LATENCY_TURN" or .event == "SESSION_ITEMS_SERVED"))
  | select((.ts | type) != "string" or .ts >= $since) | {event, attrs: (.attrs // {})}' >"$work/events"

jq -r -s --arg input "$input_desc" --arg since "$since" '
def ms: if type == "string" then
    (sub("\\.[0-9]+Z$"; "Z") | try fromdateiso8601 catch null) as $s
    | if $s == null then null
      else $s * 1000 + (([match("\\.([0-9]+)Z$").captures[0].string] | first // "0") | (. + "000")[0:3] | tonumber) end
  else null end;
def num: if type == "number" then . else null end;
def p95: if length == 0 then null else sort | .[((length * 95 + 99) / 100 | floor) - 1] end;
def fmt: if . == null then "-" else "\(round)ms" end;
def judge($n; $p; $within; $target; $alert):
  if $n >= 100 then { n: $n, p: $p, verdict: (if $p <= $target then "충족" else "미달" end), how: "p95" }
  elif $n >= 10 then ($within * 100 / $n) as $r
    | { n: $n, p: $p, verdict: (if $r >= 90 then "충족" else "미달" end), how: "목표 이내 \($r | floor)%" }
  else { n: $n, p: $p, verdict: "보류", how: "표본 \($n)개 < 10, 값 · 건수만" } end
  | .alert = (.verdict != "보류" and .p != null and .p > $alert);
def verdict_text: "\(.verdict)(\(.how))" + (if .alert then " · 경보선 초과(A-13)" else "" end);

[ .[] | select(.event == "LATENCY_TURN") | .attrs ] as $turns
| [ .[] | select(.event == "SESSION_ITEMS_SERVED") | .attrs ] as $items

# ---- NFR5.1
| [ $turns[] | .relayInMs | num | select(. != null) ] as $rin
| [ $turns[] | .relayOutMs | num | select(. != null) ] as $rout
| [ $turns[] | select((.relayInMs | num) != null and (.relayOutMs | num) != null) | .relayInMs + .relayOutMs ] as $rsum
| (if ($rin | length) > 0 and ($rout | length) > 0 then ($rin | p95) + ($rout | p95) else null end) as $relay
| judge($rsum | length; $relay; [ $rsum[] | select(. <= 500) ] | length; 500; 400) as $j1

# ---- NFR5.2
| [ $turns[]
    | (.tSpeechEnd | ms) as $t0
    | (if (.tDevicePlayStart | ms) != null and (.clockOffsetMs | num) != null
         then { t3: ((.tDevicePlayStart | ms) - .clockOffsetMs), est: false }
       elif (.tDevicePlayStartRecv | ms) != null
         then { t3: ((.tDevicePlayStartRecv | ms) - ((.rttMs | num) // 0) / 2), est: true }
       else null end) as $d
    | { t0: $t0, d: $d, err: (if (.rttMs | num) != null then .rttMs / 2 else null end),
        firstOut: (if (.tProviderFirstOut | ms) != null and $t0 != null then (.tProviderFirstOut | ms) - $t0 else null end),
        provider: (.providerResponseMs | num), quiet: (.quietWaitMs | num),
        gate: (if (.tGatePass | ms) != null and (.tSegmentConfirmed | ms) != null then (.tGatePass | ms) - (.tSegmentConfirmed | ms) else null end),
        frame: (if (.tFirstFrameSent | ms) != null and (.tGatePass | ms) != null then (.tFirstFrameSent | ms) - (.tGatePass | ms) else null end),
        play: (if $d != null and (.tGatePass | ms) != null then $d.t3 - (.tGatePass | ms) else null end),
        reason: .unobservedReason }
    | .total = (if .t0 != null and .d != null then .d.t3 - .t0 else null end) ] as $rows
| [ $rows[] | .total | select(. != null) ] as $tot
| judge($tot | length; $tot | p95; [ $tot[] | select(. <= 2500) ] | length; 2500; 2000) as $j2
| ([ $rows[] | select(.total != null and .d.est) ] | length) as $est
| ([ $rows[] | select(.total != null) | .err | select(. != null) ] | max) as $errmax
| def seg($k): [ $rows[] | .[$k] | select(. != null) ] | p95 | fmt;

# ---- NFR5.3
  [ $items[] | select(.speaker == "CHILD") | select((.tTranscriptFinal | ms) != null and (.tViewItemReady | ms) != null)
    | (.tViewItemReady | ms) - (.tTranscriptFinal | ms) ] as $srv
| [ $items[] | select(.speaker == "CHILD") | select((.tViewItemReady | ms) != null and (.tViewItemFirstServed | ms) != null)
    | (.tViewItemFirstServed | ms) - (.tViewItemReady | ms) ] as $poll
| judge($srv | length; $srv | p95; [ $srv[] | select(. <= 500) ] | length; 500; 400) as $j3

# ---- 미관측
| [ $rows[] | select(.total == null or .reason != null) ] as $un
| ($un | group_by(.reason // "사유 없음(키 없음)") | map("\(.[0].reason // "사유 없음(키 없음)") \(length)") | join(" · ")) as $reasons

| "[0] 입력: \($input) · since=\($since) · LATENCY_TURN \($turns | length)줄 · SESSION_ITEMS_SERVED \($items | length)줄",
  "[NFR5.1] 중계 증가분 = p95(relayIn) \($rin | p95 | fmt)(n=\($rin | length)) + p95(relayOut) \($rout | p95 | fmt)(n=\($rout | length)) = \($relay | fmt)(두 값이 다 있는 턴 \($j1.n)개) · 목표 ≤ 500ms · 경보선 400ms → \($j1 | verdict_text)",
  "[NFR5.2] 말 끝 → 첫 음성 재생 p95 \($j2.p | fmt)(n=\($j2.n), 기기 시계 보정 \($j2.n - $est) · 추정 \($est), 오차 ± \($errmax | fmt)) · 목표 ≤ 2500ms · 경보선 2000ms → \($j2 | verdict_text)",
  "[NFR5.2] 구간 p95: 첫 출력 \(seg("firstOut")) · 공급자 응답 \(seg("provider")) · 조용 대기 \(seg("quiet")) · 게이트 \(seg("gate")) · 첫 프레임 \(seg("frame")) · 재생 시작 \(seg("play"))",
  "[NFR5.3] 전사 확정 → 12 반영 가능(서버 몫, CHILD) p95 \($srv | p95 | fmt)(n=\($srv | length)) · 목표 ≤ 500ms · 경보선 400ms → \($j3 | verdict_text) · 폴링 몫 p95 \($poll | p95 | fmt)(참고)",
  (if ($turns | length) == 0 then "[미관측] LATENCY_TURN 줄이 없다(턴 0) — 입력 · since를 확인한다"
   elif ($un | length) == 0 then "[미관측] 0턴(0%)"
   else "[미관측] \($turns | length)턴 중 \($un | length)턴(\(($un | length) * 100 / ($turns | length) | round)%) — 사유: \($reasons)" end),
  "SUMMARY turns=\($turns | length) nfr5.1=\($j1.verdict) nfr5.2=\($j2.verdict) nfr5.3=\($j3.verdict) alerts=\([ (if $j1.verdict == "미달" or $j1.alert then "NFR5.1" else empty end), (if $j2.verdict == "미달" or $j2.alert then "NFR5.2" else empty end), (if $j3.verdict == "미달" or $j3.alert then "NFR5.3" else empty end) ] | join(","))"
' "$work/events" | tee "$work/out"

if grep -qE '^SUMMARY .* alerts=[A-Z]' "$work/out"; then
  exit 1
fi
