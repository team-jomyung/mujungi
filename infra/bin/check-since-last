#!/usr/bin/env bash
# check-since-last — 마지막 점검 이후 점검표 계산 (U1 3.5 Step 47 · monitoring 2.5.1 · 2.8 · MO-4 · OD-15 · RD-14)
#
# 점검표(하루 2회)의 값을 사람이 세지 않게 한 번에 계산한다. 기준은 '마지막 점검 이후의 최댓값'이다(게이지는 재시작하면 0이
# 되므로 현재 로그와 보존 폴더 /var/log/mujoong/archive를 시각순으로 이어서 읽는다, RD-14 · monitoring 2.4.3).
#   [1]  마지막 점검 시각: /var/lib/mujoong/last-check의 ts(없으면 24시간 전) 또는 --since
#   [2]  host-collect.log: ctr · ctrBad(A-4), readiness 200 아님 2줄 연속(A-5), 재시작 증가(A-6), 마지막 줄 5분 이상 전(A-24)
#   [3]  WARN 이상: 앱 WARN · ERROR 줄(줄 수 = 1 + attrs.repeat)과 postgres ERROR · FATAL 줄을 1분 간격으로 미는 5분 창의 최댓값 > 10(A-7)
#   [3-2] nginx 접근 로그 429 · 403 · 5xx 건수(경로 템플릿별). 기준선(첫 점검 값) 대비 판단은 사람(A-8)
#   [3-3] 로그 위생: log-hygiene-check 위반 1건 이상(A-23)
#   [4]  METRIC_SNAPSHOT outboxOldestPendingSec 최댓값 > 60(A-9)
#   [5]  EVENT_DELIVERY status FAILED · DEAD 줄 1건 이상 또는 outboxFailed · inboxDead 최댓값 1 이상(A-10)
#   [6]  poolWaitMaxMs > 100인 스냅샷이 앱별로 연속 5개(A-11)
#   [10] sysCpuAvgPct ≥ 50 · sysMemMaxPct ≥ 60 · poolActive ≥ 8이 앱별로 연속 5개(5분)(A-14)
#   [11] host-collect.log 마지막 줄: backupAgeH > 26(A-17), 디스크 80% 이상(A-15), 인증서 20일 미만(A-16)
#   [7] 가용성(probe-daily, 프로브 위치) · [8] 시작 성공률 · [9] 지연(sli-report · turn-metrics, 11/2 측정)은 이 도구 밖이다
#   [12] --record "<메모>"를 주면 지금 시각과 메모를 last-check에 쓴다(점검 기록)
#
# 쓰는 법: check-since-last [--since <ISO UTC>] [--record <메모>] [--container-logs <디렉터리>] [--no-hygiene]
#   --container-logs  현재 컨테이너 대신 합성 로그 디렉터리(<서비스>.log · archive/, 시험 · 리허설). 호스트 파일은 MUJOONG_LOG_DIR
# 표준 출력: 점검마다 한 줄(값은 건수 · 지표 숫자뿐, 로그 원문 · 비밀 없음), 끝에 `SUMMARY alerts=<n> <알림 목록>`
# 종료 코드: 0 알림 없음, 1 알림 있음, 2 전제 누락(jq · docker), 64 인자 오류

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/bin/lib/host.sh
. "$SCRIPT_DIR/lib/host.sh"

since=""
record=""
do_record=0
src=""
hygiene=1
while [ "$#" -gt 0 ]; do
  case "$1" in
    --since) since="${2:-}"; shift ;;
    --record) record="${2:-}"; do_record=1; shift ;;
    --container-logs) src="${2:-}"; shift ;;
    --no-hygiene) hygiene=0 ;;
    -h | --help) sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "check-since-last: 모르는 인자: $1" >&2; exit 64 ;;
  esac
  shift
done
if ! command -v jq >/dev/null 2>&1; then
  echo "check-since-last: 전제 누락: jq" >&2
  exit 2
fi
if [ -n "$src" ] && [ ! -d "$src" ]; then
  echo "check-since-last: --container-logs 디렉터리가 없다" >&2
  exit 64
fi
if [ -z "$src" ] && ! docker info >/dev/null 2>&1; then
  echo "check-since-last: 전제 누락: docker" >&2
  exit 2
fi
last_check="$MUJOONG_DATA_DIR/last-check"
since_source=--since
if [ -z "$since" ]; then
  since="$(sed -nE 's/^ts=([^ ]+).*/\1/p' "$last_check" 2>/dev/null | head -n 1 || true)"
  since_source=last-check
  if [ -z "$since" ]; then
    since="$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ)"
    since_source=default-24h
  fi
fi
if ! [[ "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$ ]]; then
  echo "check-since-last: since는 UTC ISO 8601(끝 Z)이다" >&2
  exit 64
fi

umask 077
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mujoong_collect_logs "$since" "$work" "$src"
now="$(mujoong_epoch)"

alerts=()
# judge <알림 id...> — 판정을 V에 두고(빈 인자면 OK) 알림 목록에 더한다. 명령 치환 안에서 부르지 않는다(목록이 사라진다)
V=OK
judge() {
  if [ "$#" -eq 0 ]; then
    V=OK
  else
    V="ALERT $(IFS=,; echo "$*")"
    alerts+=("$@")
  fi
}
body() { cut -d' ' -f2- "$1"; }
echo "[1] since=$since (출처 $since_source)"

# ---- [2] [11] host-collect.log --------------------------------------------------------------------------
hc="$work/host-collect.lines"
awk -v since="$since" '{ ts = $1; sub(/^ts=/, "", ts); if (ts >= since) print }' \
  "$MUJOONG_LOG_DIR/host-collect.log" 2>/dev/null >"$hc" || true
field() { sed -nE "s/^(.*[ ])?$1=([^ ]*).*$/\\2/p"; }
hc_lines="$(wc -l <"$hc")"
a2=()
if [ "$hc_lines" -eq 0 ]; then
  judge A-24
  echo "[2] host-collect 줄 0개(수집기 공백) → $V"
else
  bad_ctr="$(grep -c -vE '(^| )ctr=7/7 (.* )?ctrBad=none( |$)' "$hc" || true)"
  ready_streak="$(awk '{ ok = ($0 ~ / readyCore=200 / && $0 ~ / readyRealtime=200 /); if (ok) s = 0; else { s++; if (s > m) m = s } } END { print m + 0 }' "$hc")"
  restart_lines="$(grep -c -E '(^| )warn=([^ ]*,)?restarts(,| |$)' "$hc" || true)"
  last_line="$(tail -n 1 "$hc")"
  last_ts="$(field ts <<<"$last_line")"
  gap=$((now - $(mujoong_to_epoch "$last_ts" || echo 0)))
  [ "$bad_ctr" -gt 0 ] && a2+=(A-4)
  [ "$ready_streak" -ge 2 ] && a2+=(A-5)
  [ "$restart_lines" -gt 0 ] && a2+=(A-6)
  [ "$gap" -ge 300 ] && a2+=(A-24)
  judge "${a2[@]}"
  echo "[2] lines=$hc_lines ctr이상줄=$bad_ctr readiness실패연속최대=$ready_streak 재시작증가줄=$restart_lines 마지막=$last_ts(${gap}초 전) → $V"
fi

# ---- [3] WARN 이상 5분 창 --------------------------------------------------------------------------------
# 분 단위 가중치 목록: "YYYY-MM-DDTHH:MM <가중치>"
{
  for svc in core-api realtime; do
    [ -s "$work/$svc.log" ] || continue
    body "$work/$svc.log" | grep -E '^\{' | jq -R -r 'fromjson? | select(.level == "WARN" or .level == "ERROR")
      | "\(.ts[0:16]) \(1 + ((.attrs.repeat // 0) | tonumber? // 0))"' || true
  done
  if [ -s "$work/postgres.log" ]; then
    grep -E '(^| )(ERROR|FATAL):' "$work/postgres.log" | awk '{ print substr($1, 1, 16), 1 }' || true
  fi
} >"$work/warn.min"
warn_max=0
if [ -s "$work/warn.min" ]; then
  # 분 → 초(한 번의 date -f), 분 번호로 바꿔 5분 창(1분씩 밀기)의 최댓값
  awk '{ print $1 ":00Z" }' "$work/warn.min" | sed 's/T/ /' | date -u -f - +%s >"$work/warn.epoch"
  warn_max="$(paste -d' ' "$work/warn.epoch" "$work/warn.min" | awk '
    { m = int($1 / 60); w[m] += $3; if (min == "" || m < min) min = m; if (m > max) max = m }
    END {
      best = 0
      for (s = min - 4; s <= max; s++) { t = 0; for (k = s; k < s + 5; k++) t += w[k]; if (t > best) best = t }
      print best + 0
    }')"
fi
a3=()
[ "$warn_max" -gt 10 ] && a3+=(A-7)
judge "${a3[@]}"
echo "[3] WARN 이상 5분 창 최대=${warn_max}건(앱 WARN · ERROR + postgres ERROR · FATAL) → $V"

# ---- [3-2] nginx 429 · 403 · 5xx ------------------------------------------------------------------------
if [ -s "$work/nginx.log" ]; then
  ngx="$(body "$work/nginx.log" | awk '
    {
      st = ""; uri = ""
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^status=/) st = substr($i, 8)
        if ($i ~ /^uri=/) uri = substr($i, 5)
      }
      if (st !~ /^(429|403|5[0-9][0-9])$/) next
      cls = (st ~ /^5/) ? "5xx" : st
      n = split(uri, seg, "/"); t = ""
      for (j = 2; j <= n; j++) {
        s = seg[j]
        if (s ~ /^[0-9a-fA-F-]{32,36}$/) s = "{id}"; else if (s ~ /^[0-9]+$/) s = "{n}"
        t = t "/" s
      }
      if (t == "") t = "/"
      c[cls]++; p[cls " " t]++
    }
    END {
      printf "429=%d 403=%d 5xx=%d", c["429"], c["403"], c["5xx"]
      for (k in p) printf " [%s:%d]", k, p[k]
    }')"
else
  ngx="429=0 403=0 5xx=0"
fi
echo "[3-2] nginx $ngx → 기록(기준선 대비 급증 판단은 사람, A-8)"

# ---- [3-3] 로그 위생 ----------------------------------------------------------------------------------
if [ "$hygiene" -eq 1 ]; then
  hy_args=(--since "$since")
  [ -n "$src" ] && hy_args+=(--container-logs "$src")
  hy_rc=0
  hy_out="$("$SCRIPT_DIR/log-hygiene-check" "${hy_args[@]}" 2>&1)" || hy_rc=$?
  hy_total="$(sed -nE 's/^SUMMARY violations=([0-9]+).*/\1/p' <<<"$hy_out")"
  a33=()
  if [ "$hy_rc" -eq 1 ]; then
    a33+=(A-23)
  elif [ "$hy_rc" -ne 0 ]; then
    a33+=(A-23)
    hy_total="실행 실패(rc=$hy_rc)"
  fi
  judge "${a33[@]}"
  echo "[3-3] 로그 위생 위반=${hy_total:-?} → $V"
else
  echo "[3-3] 로그 위생: 건너뜀(--no-hygiene)"
fi

# ---- [4] [5] [6] [10] METRIC_SNAPSHOT · EVENT_DELIVERY -------------------------------------------------------
: >"$work/snap"
delivery_failed=0
for svc in core-api realtime; do
  [ -s "$work/$svc.log" ] || continue
  body "$work/$svc.log" | grep -E '^\{' | jq -R -r --arg app "$svc" 'fromjson? | select(.event == "METRIC_SNAPSHOT")
    | [$app, .ts, (.attrs.outboxOldestPendingSec // 0), (.attrs.outboxFailed // 0), (.attrs.inboxDead // 0),
       (.attrs.poolWaitMaxMs // 0), (.attrs.sysCpuAvgPct // 0), (.attrs.sysMemMaxPct // 0), (.attrs.poolActive // 0)]
    | map(tostring) | join(" ")' >>"$work/snap" || true
  n="$(body "$work/$svc.log" | grep -E '^\{' | jq -R -r 'fromjson? | select(.event == "EVENT_DELIVERY"
    and (.attrs.status == "FAILED" or .attrs.status == "DEAD")) | 1' | wc -l || true)"
  delivery_failed=$((delivery_failed + n))
done
# 앱별 시각순으로 정렬해 최댓값 · 연속 길이를 잰다
read -r pending_max ofail_max idead_max pool_streak cpu_streak mem_streak active_streak < <(sort -k1,1 -k2,2 "$work/snap" | awk '
  function streak(name, cond) { if (cond) { cur[name]++; if (cur[name] > best[name]) best[name] = cur[name] } else cur[name] = 0 }
  {
    if ($1 != app) { app = $1; cur["pool"] = 0; cur["cpu"] = 0; cur["mem"] = 0; cur["act"] = 0 }
    if ($3 + 0 > pm) pm = $3 + 0
    if ($4 + 0 > of) of = $4 + 0
    if ($5 + 0 > id) id = $5 + 0
    streak("pool", $6 + 0 > 100)
    streak("cpu", $7 + 0 >= 50)
    streak("mem", $8 + 0 >= 60)
    streak("act", $9 + 0 >= 8)
  }
  END { printf "%d %d %d %d %d %d %d\n", pm, of, id, best["pool"], best["cpu"], best["mem"], best["act"] }')
snaps="$(wc -l <"$work/snap")"
a4=()
[ "$pending_max" -gt 60 ] && a4+=(A-9)
judge "${a4[@]}"
echo "[4] PENDING 최장 나이 최댓값=${pending_max}초(스냅샷 $snaps개) → $V"
a5=()
{ [ "$delivery_failed" -ge 1 ] || [ "$ofail_max" -ge 1 ] || [ "$idead_max" -ge 1 ]; } && a5+=(A-10)
judge "${a5[@]}"
echo "[5] EVENT_DELIVERY FAILED · DEAD=$delivery_failed outboxFailed 최대=$ofail_max inboxDead 최대=$idead_max → $V"
a6=()
[ "$pool_streak" -ge 5 ] && a6+=(A-11)
judge "${a6[@]}"
echo "[6] 풀 대기 100ms 초과 연속 최대=${pool_streak}개 → $V"
a10=()
{ [ "$cpu_streak" -ge 5 ] || [ "$mem_streak" -ge 5 ] || [ "$active_streak" -ge 5 ]; } && a10+=(A-14)
judge "${a10[@]}"
echo "[10] 자원 연속: CPU≥50% ${cpu_streak}개 · 메모리≥60% ${mem_streak}개 · 풀≥8 ${active_streak}개 → $V"

# ---- [11] 백업 · 디스크 · 인증서(host-collect 마지막 줄) -------------------------------------------------------
a11=()
if [ "$hc_lines" -gt 0 ]; then
  last_line="$(tail -n 1 "$hc")"
  bk="$(field backupAgeH <<<"$last_line")"
  { [ "$bk" = NA ] || { [[ "$bk" =~ ^[0-9]+$ ]] && [ "$bk" -gt 26 ]; }; } && a11+=(A-17)
  disk_bad=0
  for k in diskRoot diskData diskBackup; do
    v="$(field "$k" <<<"$last_line")"
    if ! [[ "$v" =~ ^[0-9]+$ ]] || [ "$v" -ge 80 ]; then disk_bad=1; fi
  done
  [ "$disk_bad" -eq 1 ] && a11+=(A-15)
  cert_bad=0
  for k in certDays certServedDays; do
    v="$(field "$k" <<<"$last_line")"
    if ! [[ "$v" =~ ^-?[0-9]+$ ]] || [ "$v" -lt 20 ]; then cert_bad=1; fi
  done
  [ "$cert_bad" -eq 1 ] && a11+=(A-16)
  judge "${a11[@]}"
  echo "[11] backupAgeH=$bk diskRoot=$(field diskRoot <<<"$last_line") diskData=$(field diskData <<<"$last_line") diskBackup=$(field diskBackup <<<"$last_line") certDays=$(field certDays <<<"$last_line") certServedDays=$(field certServedDays <<<"$last_line") → $V"
else
  judge A-24
  echo "[11] host-collect 줄이 없어 판단할 수 없다 → $V"
fi
echo "[7][8][9] 가용성 · 시작 성공률 · 지연은 probe-daily · sli-report · turn-metrics(이 도구 밖)"

# ---- [12] 기록 ---------------------------------------------------------------------------------------
if [ "$do_record" -eq 1 ]; then
  note="$(printf '%s' "$record" | tr -d '\000-\037' | cut -c1-200)"
  tmp="$(mktemp "$MUJOONG_DATA_DIR/.last-check.XXXXXX")"
  printf 'ts=%s note=%s\n' "$(mujoong_now_iso)" "$note" >"$tmp"
  chmod 0640 "$tmp"
  mv -f "$tmp" "$last_check"
  echo "[12] last-check 기록함"
fi

# 같은 알림이 여러 점검에서 나오면 한 번만 센다
mapfile -t uniq_alerts < <(printf '%s\n' "${alerts[@]}" | grep -v '^$' | sort -u)
echo "SUMMARY alerts=${#uniq_alerts[@]} $(IFS=,; echo "${uniq_alerts[*]}")"
if [ "${#uniq_alerts[@]}" -gt 0 ]; then
  exit 1
fi
