#!/usr/bin/env bash
# deploy-apply — 배포 2단계: D3 준비(대상 기준) · D4 migrate · D5 두 앱 병렬 재생성 · D6 web · D7 nginx · D8 스모크 · D9 끝 기록
# (U1 3.5 Step 47 · cicd 2.3.3 · 2.4 · 2.5.1 · 2.6 · 2.8 · 2.9 · 2.10 · infra-spec 2.2 · 3.7 · 4.2 · 4.4 · monitoring 2.4.3 · 2.6.5 ·
#  CD-4 ~ CD-11 · R4-8 · R4-11 · R4-12 · R4-13 · RD-19 · J92 · J128)
#
# 대상 릴리스(/opt/mujoong/releases/<SHA>/bin)의 이 스크립트를 deploy-stage1(현재 릴리스)이 부른다. 직접 부르지 않는다
# (stage1이 잡은 호스트 잠금이 없으면 거부한다). 단계(cicd 2.6.1, 롤백은 D4를 건너뛴다):
#   D3  render-env(파라미터 → /opt/mujoong/env, 경로 조회가 읽기 실패면 이름 조회로 한 번 더, R4-18) → Compose 유효성(config --quiet)
#       → D3 확인(infra-validate: Compose 불변식 · demo 프로필(SPRING_PROFILES_ACTIVE=demo, 시험 로그인 · 부하 시험 꺼짐, CD-7) ·
#       비밀은 env 파일로만, 메모리 한도 합계 ≤ MemTotal의 70%) → 호스트에 없는 이미지 pull(migrate 포함) → 인증서 파일 확인(없으면 RUNBOOK
#       4.5.1 5-c) → 고정 경로 동기화(승인 음성은 더하기 · 갱신만, postgres/init · backup은 변경 시 파일 단위 원자 교체,
#       postgresql.conf 렌더) → 디스크 여유 5GB 이상
#   D4  (DEPLOY만) `mj --profile migrate run --rm migrate`(구 앱 가동 중). 출력은 migrate-<배포 id>.log. 실패하면 앱을 건드리지 않는다
#   D5  ① 재생성 대상(realtime · core-api 중 설정 해시가 바뀐 것)의 로그 보존(archive/<UTC>-<서비스>-<배포 id>.log.gz) ② current 링크를
#       새 릴리스로 원자 교체 ③ 1초 샘플러(probe-three --interval 1, 루프백) 시작 ④ `up -d --no-deps realtime`과
#       `up -d --no-deps core-api`를 별도 프로세스로 동시에 실행하고 둘 다 기다린다 ⑤ readiness(healthy) 대기 realtime → core-api, 각 120초
#   D6  web이 바뀌었으면 로그 보존 → 재생성 → healthy 60초. 백업 스케줄 정의가 바뀌었거나 backup · certbot 정의가 바뀌었으면 재생성
#       → healthy 100초(헬스체크 start_period 30 + interval 60 + 여유. 그냥 넘기면 D8 8-5가 starting을 만나 실패한다, 리허설 실측)
#   D7  render-nginx(임시) → 일회성 컨테이너 `nginx -t` → 통과하면 고정 경로 /opt/mujoong/nginx 갱신 → reload(이미지가 바뀌었으면
#       재생성). 렌더 결과와 이미지가 같으면 건너뛴다. `-t` 실패면 갱신하지 않고 배포 실패(활성 설정은 그대로)
#   D8  smoke 8-1 ~ 8-6
#   D9  샘플러 종료 · downtimeSec · deviceDownSec · budget(60초) → DEPLOY_END → last-ok 기록 → 정리(이미지는 현재 · 직전 SHA만,
#       릴리스 폴더 최근 5개 + 현재 · 직전, archive 7일 · 40개 초과분) → 고정 진입점(/opt/mujoong/bin) 갱신 → 호스트 기준선 차이 경고
#   정리 실패는 결과에 영향이 없고 WARN으로 남긴다. D5 이후 실패는 배포 실패 표시이고 롤백은 사람이 한다(자동 롤백 없음, CD-6).
# 기록: deploy.log(DEPLOY_STEP · DEPLOY_END, cicd 2.10)와 deploy-<배포 id>.log(단계별 상세, 값 없음). 값은 어디에도 출력하지 않는다.
#
# 쓰는 법: deploy-apply --release <릴리스 폴더> --sha <SHA> --mode DEPLOY|ROLLBACK --deploy-id <id> --prev-sha <SHA|none>
#                       --started <시작 초> --d3-started <D3 시작 초>
# 종료 코드: 0 성공, 1 배포 실패, 64 인자 오류, 77 잠금 · 권한 조건

set -Eeuo pipefail
set +x
umask 027

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/bin/lib/host.sh
. "$SCRIPT_DIR/lib/host.sh"
readonly BIN="$SCRIPT_DIR"
readonly APP_READY_SEC=120 WEB_READY_SEC=60 AUX_READY_SEC=100 DOWNTIME_BUDGET_SEC=60 DISK_MIN_KB=$((5 * 1024 * 1024))
readonly KEEP_RELEASES=5 ARCHIVE_DAYS=7 ARCHIVE_MAX=40

release=""
sha=""
mode=""
deploy_id=""
prev_sha=""
started=""
d3_started=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --release) release="${2:-}"; shift ;;
    --sha) sha="${2:-}"; shift ;;
    --mode) mode="${2:-}"; shift ;;
    --deploy-id) deploy_id="${2:-}"; shift ;;
    --prev-sha) prev_sha="${2:-}"; shift ;;
    --started) started="${2:-}"; shift ;;
    --d3-started) d3_started="${2:-}"; shift ;;
    -h | --help) sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "deploy-apply: 모르는 인자: $1" >&2; exit 64 ;;
  esac
  shift
done
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "deploy-apply: --sha 형식" >&2; exit 64; }
case "$mode" in DEPLOY | ROLLBACK) ;; *) echo "deploy-apply: --mode는 DEPLOY 또는 ROLLBACK" >&2; exit 64 ;; esac
[[ "$deploy_id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}$ ]] || { echo "deploy-apply: --deploy-id 형식" >&2; exit 64; }
[[ "$prev_sha" =~ ^([0-9a-f]{40}|none)$ ]] || { echo "deploy-apply: --prev-sha 형식" >&2; exit 64; }
if ! [[ "$started" =~ ^[0-9]+$ ]] || ! [[ "$d3_started" =~ ^[0-9]+$ ]]; then
  echo "deploy-apply: --started · --d3-started는 초" >&2
  exit 64
fi
if [ -z "$release" ] || [ "$(cd "$release" 2>/dev/null && pwd)" != "$(cd "$SCRIPT_DIR/.." && pwd)" ]; then
  echo "deploy-apply: --release는 이 스크립트가 든 릴리스 폴더여야 한다" >&2
  exit 64
fi
release="$(cd "$release" && pwd)"
if [ "$(id -u)" -ne 0 ]; then
  echo "deploy-apply: root로 실행해야 한다" >&2
  exit 77
fi
# stage1이 잡은 잠금이 있어야 한다(잠금을 지금 잡을 수 있으면 아무도 잡고 있지 않은 것)
if flock -n "$MUJOONG_OPT/.deploy.lock" true; then
  echo "deploy-apply: deploy-stage1을 거쳐야 한다(호스트 잠금이 없다)" >&2
  exit 77
fi

step_log="$MUJOONG_LOG_DIR/deploy-$deploy_id.log"
state_file="$MUJOONG_OPT/.deploy-state"
work="$(mktemp -d)"
sampler_pid=""
sampler_file="$work/sampler.log"
current_step=D3
step_started="$d3_started"

log() { echo "$(mujoong_now_iso) $*" >>"$step_log"; }
set_step() {
  current_step="$1"
  step_started="$(mujoong_epoch)"
  printf '%s %s\n' "$deploy_id" "$1" >"$state_file"
}
step_ok() { mujoong_deploy_log "event=DEPLOY_STEP deployId=$deploy_id step=$current_step result=OK durationSec=$(($(mujoong_epoch) - step_started))"; }
mj() { "$BIN/mj" --release "$release" "$@"; }

# 샘플러를 멈추고 down · dev · budget을 정한다(샘플러를 돌리지 않았으면 0 0 OK, 요약하지 못하면 NA NA NA).
# 샘플러는 이 셸의 자식이므로 이 셸에서 기다린다(명령 치환 · 프로세스 치환 안에서 부르지 않는다)
down=0
dev=0
budget=OK
stop_sampler() {
  [ -n "$sampler_pid" ] || return 0
  kill -TERM "$sampler_pid" 2>/dev/null || true
  wait "$sampler_pid" 2>/dev/null || true
  sampler_pid=""
  local summary
  summary="$("$BIN/probe-three" --summarize "$sampler_file" 2>/dev/null || true)"
  down="$(sed -nE 's/.*downtimeSec=([0-9]+).*/\1/p' <<<"$summary")"
  dev="$(sed -nE 's/.*deviceDownSec=([0-9]+).*/\1/p' <<<"$summary")"
  if [ -z "$down" ] || [ -z "$dev" ]; then
    down=NA
    dev=NA
    budget=NA
  elif [ "$down" -le "$DOWNTIME_BUDGET_SEC" ]; then
    budget=OK
  else
    budget=OVER
  fi
}
end_written=0
write_end() { # <OK|FAIL|ABORTED> <failedStep|none>
  stop_sampler
  mujoong_deploy_log "event=DEPLOY_END deployId=$deploy_id sha=$sha result=$1 failedStep=$2 durationSec=$(($(mujoong_epoch) - started)) downtimeSec=$down deviceDownSec=$dev budget=$budget"
  end_written=1
}
fail() { # <사유(값 없음)>
  log "실패 $current_step: $1"
  mujoong_deploy_log "event=DEPLOY_STEP deployId=$deploy_id step=$current_step result=FAIL durationSec=$(($(mujoong_epoch) - step_started))"
  write_end FAIL "$current_step"
  exit 1
}
on_exit() {
  local rc=$?
  trap - EXIT INT TERM
  if [ "$end_written" -eq 0 ]; then
    log "예상하지 못한 종료(rc=$rc) 단계 $current_step"
    write_end FAIL "$current_step"
    [ "$rc" -eq 0 ] && rc=1
  fi
  rm -rf "$work"
  exit "$rc"
}
on_signal() {
  trap - INT TERM
  log "신호로 중단 단계 $current_step"
  write_end ABORTED "$current_step"
  exit "$1"
}
trap on_exit EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

# will_recreate <서비스> — 설정 해시가 실행 중 컨테이너와 다르거나 컨테이너가 없으면 참(Compose가 다시 만든다)
will_recreate() {
  local svc="$1" cid want have
  cid="$(mujoong_container_id "$svc")"
  [ -n "$cid" ] || return 0
  want="$(mj config --hash "$svc" 2>/dev/null | awk -v s="$svc" '$1 == s { print $2 }')"
  have="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.config-hash"}}' "$cid" 2>/dev/null || true)"
  [ -z "$want" ] || [ "$want" != "$have" ]
}
# archive_logs <서비스> — 재생성 전 컨테이너 로그 보존(monitoring 2.4.3 MO-5)
archive_logs() {
  local svc="$1" cid out
  cid="$(mujoong_container_id "$svc")"
  [ -n "$cid" ] || return 0
  out="$MUJOONG_LOG_DIR/archive/$(date -u +%Y%m%dT%H%M%SZ)-$svc-$deploy_id.log.gz"
  if docker logs --timestamps "$cid" 2>&1 | gzip -c >"$out"; then
    log "로그 보존: archive/$(basename "$out")"
  else
    log "WARN 로그 보존 실패: $svc"
  fi
}
# sync_dir <원본> <고정 경로> <삭제 여부 1|0> — 바뀐 파일만 임시 파일 → 이름 변경. 바뀌면 0(참)
sync_dir() {
  local src="$1" dst="$2" prune="$3" changed=1 f rel tmp
  mkdir -p "$dst"
  chmod 0755 "$dst"
  while IFS= read -r -d '' f; do
    rel="${f#"$src"/}"
    if ! cmp -s "$f" "$dst/$rel"; then
      mkdir -p "$(dirname "$dst/$rel")"
      tmp="$(mktemp "$(dirname "$dst/$rel")/.sync.XXXXXX")"
      cp "$f" "$tmp"
      if [ -x "$f" ]; then chmod 0755 "$tmp"; else chmod 0644 "$tmp"; fi
      mv -f -- "$tmp" "$dst/$rel"
      changed=0
    fi
  done < <(find "$src" -type f -print0)
  if [ "$prune" -eq 1 ]; then
    while IFS= read -r -d '' f; do
      rel="${f#"$dst"/}"
      if [ ! -e "$src/$rel" ]; then
        rm -f -- "$f"
        changed=0
      fi
    done < <(find "$dst" -type f -print0)
  fi
  return "$changed"
}

# ---- D3 준비(대상 기준) ---------------------------------------------------------------------------
printf '%s %s\n' "$deploy_id" D3 >"$state_file"
host="$(mujoong_service_host 2>/dev/null || true)"
region="$(mujoong_aws_region)" || fail "AWS 리전을 알 수 없다"
rc=0
"$BIN/render-env" --out "$MUJOONG_ENV_DIR" --region "$region" >>"$step_log" 2>&1 || rc=$?
if [ "$rc" -eq 2 ]; then
  log "render-env 경로 조회가 읽기 실패 — 이름 조회로 다시 시도(R4-18 · V-12)"
  rc=0
  "$BIN/render-env" --out "$MUJOONG_ENV_DIR" --region "$region" --by-names >>"$step_log" 2>&1 || rc=$?
fi
[ "$rc" -eq 0 ] || fail "env 파일 렌더 실패(rc=$rc, 필수 파라미터 · 형식, 구 버전 유지)"
host="$(mujoong_service_host)" || fail "렌더된 nginx.env에 SERVICE_HOST가 없다"
mj config --quiet >>"$step_log" 2>&1 || fail "대상 Compose 설정이 유효하지 않다(config --quiet)"
mem_total_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
mem_limit=$((mem_total_kb * 1024 * 7 / 10))
if ! "$BIN/infra-validate" --only compose-invariants,demo-profile,secret-env-files --env-dir "$MUJOONG_ENV_DIR" \
  --release-env "$release/release.env" --mem-limit-bytes "$mem_limit" >>"$step_log" 2>&1; then
  fail "D3 확인 실패(Compose 불변식 · demo 프로필 · 비밀 분배 · 메모리 70%, 상세는 단계 로그)"
fi
# 태그가 SHA · 고정 판이라 변하지 않으므로 호스트에 없는 이미지만 받는다(레지스트리 요청 한도 · 일시 장애에 덜 민감, 롤백은 네트워크 없이)
mj --profile migrate pull --quiet --policy missing >>"$step_log" 2>&1 || fail "이미지 pull 실패"
cert="$MUJOONG_DATA_DIR/certbot/conf/live/$host/fullchain.pem"
[ -s "$cert" ] || fail "인증서 파일이 없다 — 최초 발급은 RUNBOOK 4.5.1 5-c(cicd 2.11)"
# 승인 음성: 더하기 · 갱신만(지우지 않는다, infra-spec 3.1)
if sync_dir "$release/seed-audio" "$MUJOONG_AUDIO_DIR" 0; then
  log "승인 음성 동기화: 바뀐 파일 있음"
fi
if sync_dir "$release/postgres/init" "$MUJOONG_OPT/postgres/init" 1; then
  log "postgres/init 갱신(기존 데이터 볼륨에는 다시 돌지 않는다, J84(d))"
fi
pgconf_before="$(sha256sum "$MUJOONG_OPT/postgres/postgresql.conf" 2>/dev/null || true)"
"$BIN/render-pgconf" --out "$MUJOONG_OPT/postgres/postgresql.conf" >>"$step_log" 2>&1 || fail "postgresql.conf 렌더 실패"
if [ "$pgconf_before" != "$(sha256sum "$MUJOONG_OPT/postgres/postgresql.conf")" ]; then
  log "WARN postgresql.conf가 바뀌었다 — 배포는 postgres를 재시작하지 않는다(RUNBOOK '설정 변경')"
fi
backup_changed=0
if sync_dir "$release/backup" "$MUJOONG_OPT/backup" 1; then
  backup_changed=1
  log "backup 스크립트 · 스케줄 정의 갱신 — D6에서 backup 컨테이너를 다시 만든다(R4-12)"
fi
avail_kb="$(df -Pk / | awk 'NR == 2 { print $4 }')"
[ "$avail_kb" -ge "$DISK_MIN_KB" ] || fail "루트 볼륨 여유가 5GB 미만이다"
step_ok

# ---- D4 migrate(DEPLOY만) -------------------------------------------------------------------------
if [ "$mode" = DEPLOY ]; then
  set_step D4
  if mj --profile migrate run --rm migrate >"$MUJOONG_LOG_DIR/migrate-$deploy_id.log" 2>&1; then
    step_ok
  else
    fail "migrate 실패(migrate-$deploy_id.log, 구 앱은 계속 돈다 — cicd 2.9)"
  fi
fi

# Graph startup is a prerequisite even though application recreation uses --no-deps.
mkdir -p "$MUJOONG_DATA_DIR/neo4j/data" "$MUJOONG_DATA_DIR/neo4j/logs"
chown 7474:7474 "$MUJOONG_DATA_DIR/neo4j/data" "$MUJOONG_DATA_DIR/neo4j/logs"
mj up -d --no-deps neo4j >>"$step_log" 2>&1 || fail "neo4j 기동 실패"
mujoong_wait_healthy neo4j 180 || fail "neo4j가 준비되지 않았다"

# ---- D5 realtime · core-api 병렬 재생성 ---------------------------------------------------------------
set_step D5
: >"$work/restarts.before"
for svc in "${MUJOONG_ALWAYS_ON[@]}"; do
  cid="$(mujoong_container_id "$svc")"
  [ -n "$cid" ] || continue
  printf '%s %s %s\n' "$svc" "$cid" "$(docker inspect --format '{{.RestartCount}}' "$cid" 2>/dev/null || echo 0)" >>"$work/restarts.before"
done
for svc in realtime core-api; do
  if will_recreate "$svc"; then
    archive_logs "$svc"
  fi
done
ln -sfn "releases/$sha" "$MUJOONG_OPT/.current.new"
mv -T "$MUJOONG_OPT/.current.new" "$MUJOONG_OPT/current"
log "current → releases/$sha"
origin="$(mujoong_allowed_origin 2>/dev/null || true)"
sampler=("$BIN/probe-three" --host "$host" --connect 127.0.0.1 --interval 1 --out "$sampler_file")
[[ "$origin" =~ ^https:// ]] && sampler+=(--origin "$origin")
"${sampler[@]}" >/dev/null 2>&1 &
sampler_pid=$!
r1=0
r2=0
mj up -d --no-deps realtime >>"$step_log" 2>&1 &
p1=$!
mj up -d --no-deps core-api >>"$step_log" 2>&1 &
p2=$!
wait "$p1" || r1=$?
wait "$p2" || r2=$?
if [ "$r1" -ne 0 ] || [ "$r2" -ne 0 ]; then
  fail "재생성 실패(realtime rc=$r1, core-api rc=$r2)"
fi
mujoong_wait_healthy realtime "$APP_READY_SEC" || fail "realtime readiness가 ${APP_READY_SEC}초 안에 오지 않았다"
mujoong_wait_healthy core-api "$APP_READY_SEC" || fail "core-api readiness가 ${APP_READY_SEC}초 안에 오지 않았다"
step_ok

# ---- D6 web(그리고 backup · certbot 정의 변경) -------------------------------------------------------------
set_step D6
if will_recreate web; then
  archive_logs web
  mj up -d --no-deps web >>"$step_log" 2>&1 || fail "web 재생성 실패"
  mujoong_wait_healthy web "$WEB_READY_SEC" || fail "web이 ${WEB_READY_SEC}초 안에 healthy가 되지 않았다"
fi
aux=()
if [ "$backup_changed" -eq 1 ] || will_recreate backup; then
  archive_logs backup
  mj up -d --no-deps --force-recreate backup >>"$step_log" 2>&1 || fail "backup 재생성 실패"
  aux+=(backup)
fi
if will_recreate certbot; then
  archive_logs certbot
  mj up -d --no-deps certbot >>"$step_log" 2>&1 || fail "certbot 재생성 실패"
  aux+=(certbot)
fi
# 둘은 동시에 시작했으므로 차례로 기다려도 합계는 늘지 않는다
for svc in "${aux[@]}"; do
  mujoong_wait_healthy "$svc" "$AUX_READY_SEC" || fail "$svc이(가) ${AUX_READY_SEC}초 안에 healthy가 되지 않았다"
done
if will_recreate postgres; then
  log "WARN postgres 정의가 바뀌었다 — 배포는 postgres를 다시 만들지 않는다(RUNBOOK '설정 변경')"
fi
step_ok

# ---- D7 nginx 적재 ------------------------------------------------------------------------------------
set_step D7
"$BIN/render-nginx" --out "$work/nginx" --mode https --env-file "$MUJOONG_ENV_DIR/nginx.env" >>"$step_log" 2>&1 \
  || fail "Nginx 설정 렌더 실패"
nginx_recreate=0
will_recreate nginx && nginx_recreate=1
if [ "$nginx_recreate" -eq 0 ] && diff -rq "$work/nginx" "$MUJOONG_OPT/nginx" >/dev/null 2>&1; then
  log "Nginx 설정 · 이미지 변화 없음 — 적재를 건너뛴다"
else
  nginx_image="$(sed -nE 's/^[[:space:]]+image:[[:space:]]*(nginx:[^[:space:]]+).*/\1/p' "$release/compose.demo.yml" | head -n 1)"
  [ -n "$nginx_image" ] || fail "compose.demo.yml에서 nginx 이미지를 찾지 못했다"
  chmod -R go+rX "$work/nginx"
  if ! docker run --rm --network none --entrypoint nginx \
    -v "$work/nginx:/etc/nginx/mujoong:ro" -v "$MUJOONG_DATA_DIR/certbot/conf:/etc/letsencrypt:ro" \
    -v "$MUJOONG_DATA_DIR/certbot/www:/var/www/certbot:ro" -v "$MUJOONG_AUDIO_DIR:/srv/mujoong/approved-audio:ro" \
    "$nginx_image" -t -q -c /etc/nginx/mujoong/nginx.conf >>"$step_log" 2>&1; then
    fail "nginx -t 실패(고정 경로를 갱신하지 않았다, 활성 설정 그대로)"
  fi
  "$BIN/render-nginx" --out "$MUJOONG_OPT/nginx" --mode https --env-file "$MUJOONG_ENV_DIR/nginx.env" >>"$step_log" 2>&1 \
    || fail "고정 경로 /opt/mujoong/nginx 갱신 실패"
  if [ "$nginx_recreate" -eq 1 ]; then
    archive_logs nginx
    mj up -d --no-deps nginx >>"$step_log" 2>&1 || fail "nginx 재생성 실패"
    mujoong_wait_healthy nginx "$WEB_READY_SEC" || fail "nginx가 ${WEB_READY_SEC}초 안에 healthy가 되지 않았다"
  else
    mj exec -T nginx nginx -s reload -c /etc/nginx/mujoong/nginx.conf >>"$step_log" 2>&1 || fail "nginx reload 실패"
  fi
fi
step_ok

# ---- D8 스모크 --------------------------------------------------------------------------------------
set_step D8
if ! "$BIN/smoke" --release "$release" --host "$host" --restarts-before "$work/restarts.before" >>"$step_log" 2>&1; then
  fail "스모크 실패($(grep -m 3 '^FAIL' "$step_log" | cut -c1-120 | paste -sd' ' -))"
fi
step_ok

# ---- D9 끝 기록과 정리 ---------------------------------------------------------------------------------
set_step D9
write_end OK none
printf '%s\n' "$sha" >"$MUJOONG_OPT/.last-ok.new"
mv -f "$MUJOONG_OPT/.last-ok.new" "$MUJOONG_OPT/last-ok"

cleanup_warn() { log "WARN 정리: $*"; }
registry="$(mujoong_release_value "$release" MUJOONG_REGISTRY || true)"
keep_re="^($sha${prev_sha:+|$prev_sha})$"
if [ -n "$registry" ]; then
  while read -r ref; do
    tag="${ref##*:}"
    [[ "$tag" =~ ^[0-9a-f]{40}$ ]] || continue
    [[ "$tag" =~ $keep_re ]] && continue
    docker image rm "$ref" >/dev/null 2>&1 || cleanup_warn "이미지 $ref(사용 중일 수 있음)"
  done < <(docker image ls --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -E "^$registry/mujoong-[a-z-]+:" || true)
fi
keep=0
while read -r dir; do
  name="$(basename "$dir")"
  keep=$((keep + 1))
  if [ "$keep" -le "$KEEP_RELEASES" ] || [ "$name" = "$sha" ] || [ "$name" = "$prev_sha" ]; then
    continue
  fi
  rm -rf -- "$dir" || cleanup_warn "릴리스 폴더 $name"
done < <(find "$MUJOONG_OPT/releases" -mindepth 1 -maxdepth 1 -type d -name '[0-9a-f]*' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
find "$MUJOONG_OPT/releases" -mindepth 1 -maxdepth 1 -type d -name '.*' -mmin +1440 -exec rm -rf -- {} + 2>/dev/null || true
find "$MUJOONG_LOG_DIR/archive" -maxdepth 1 -type f -name '*.log.gz' -mtime +"$ARCHIVE_DAYS" -delete 2>/dev/null \
  || cleanup_warn "archive 7일 지난 파일"
find "$MUJOONG_LOG_DIR/archive" -maxdepth 1 -type f -name '*.log.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn \
  | awk -v max="$ARCHIVE_MAX" 'NR > max { sub(/^[^ ]+ /, ""); print }' | while read -r old; do rm -f -- "$old"; done
# 고정 진입점 갱신(원자 교체, infra-spec 4.2)
if [ -d "$release/host/entry" ]; then
  mkdir -p "$MUJOONG_OPT/bin"
  for f in "$release/host/entry"/*; do
    [ -f "$f" ] || continue
    dst="$MUJOONG_OPT/bin/$(basename "$f")"
    if ! cmp -s "$f" "$dst"; then
      tmp="$(mktemp "$MUJOONG_OPT/bin/.entry.XXXXXX")"
      if cp "$f" "$tmp" && chmod 0755 "$tmp" && mv -f -- "$tmp" "$dst"; then
        log "진입점 갱신: bin/$(basename "$f")"
      else
        rm -f -- "$tmp"
        cleanup_warn "진입점 $(basename "$f")"
      fi
    fi
  done
fi
# 호스트 기준선(systemd · cron · logrotate · sysctl · daemon.json)은 자동 설치하지 않고 차이만 알린다(RUNBOOK '호스트 기준선')
drift=()
check_drift() { [ -f "$1" ] && ! cmp -s "$1" "$2" && drift+=("$2"); return 0; }
check_drift "$release/host/systemd/mujoong-compose.service" /etc/systemd/system/mujoong-compose.service
check_drift "$release/host/systemd/mujoong-power-mark.service" /etc/systemd/system/mujoong-power-mark.service
check_drift "$release/host/docker.service.d/mujoong-mounts.conf" /etc/systemd/system/docker.service.d/mujoong-mounts.conf
check_drift "$release/host/cron.d/mujoong" /etc/cron.d/mujoong
check_drift "$release/host/logrotate.d/mujoong" /etc/logrotate.d/mujoong
check_drift "$release/host/sysctl.d/90-mujoong.conf" /etc/sysctl.d/90-mujoong.conf
check_drift "$release/host/daemon.json" /etc/docker/daemon.json
if [ "${#drift[@]}" -gt 0 ]; then
  log "WARN 호스트 기준선이 릴리스와 다르다: ${drift[*]}"
  echo "deploy-apply: WARN 호스트 기준선 차이 ${#drift[@]}건(deploy-$deploy_id.log, RUNBOOK '호스트 기준선')"
fi
rm -f "$state_file"
