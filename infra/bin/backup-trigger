#!/usr/bin/env bash
# backup-trigger — 정기 외 백업 트리거 (U1 3.5 Step 47 · infra-spec 4.4 · N-10 · cicd 2.6.1 D2 · RD-20)
#
# backup 컨테이너의 /opt/mujoong/backup/backup.sh(같은 스크립트 · flock으로 겹침 방지)를 docker compose exec로 부른다.
# 트리거와 부르는 곳(infra-spec 4.4):
#   deploy  배포 D2(deploy-stage1). 실패하면 배포를 멈춘다(복원 지점이 없다)
#   stop    mujoong-compose.service 정지 단계: --max-age-hours 1 --timeout 60, 실패해도 정지는 진행(단위가 결과를 무시)
#   boot    mujoong-compose.service 시작 뒤 비동기(systemd-run): --max-age-hours 24
#   manual  사람(점검표 E3 · RUNBOOK)
#
# 쓰는 법: backup-trigger --trigger deploy|stop|boot|manual [--max-age-hours <n>] [--timeout <초>] [--release <릴리스 폴더>]
#   --max-age-hours  마지막 성공 백업(backup.log의 BACKUP_END result=OK)이 이 시간보다 최근이면 건너뛴다(종료 코드 0)
#   --timeout        exec 전체 제한(기본 600초). 넘으면 종료 코드 124
# 표준 출력: 결과 한 줄(값 없음). 백업 스크립트의 결과 줄은 backup.log와 backup 컨테이너 로그에 남는다.
# 종료 코드: 0 성공 · 최근 성공이 있어 건너뜀 · 겹쳐서 건너뜀, 1 실패, 3 데이터 등급 거부(SD-24), 124 시간 초과, 64 인자 오류

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/bin/lib/host.sh
. "$SCRIPT_DIR/lib/host.sh"

trigger=""
max_age_hours=""
timeout_sec=600
release="$MUJOONG_OPT/current"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --trigger) trigger="${2:-}"; shift ;;
    --max-age-hours) max_age_hours="${2:-}"; shift ;;
    --timeout) timeout_sec="${2:-}"; shift ;;
    --release) release="${2:-}"; shift ;;
    -h | --help) sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "backup-trigger: 모르는 인자: $1" >&2; exit 64 ;;
  esac
  shift
done
case "$trigger" in
  deploy | stop | boot | manual) ;;
  *) echo "backup-trigger: --trigger는 deploy · stop · boot · manual 중 하나다" >&2; exit 64 ;;
esac
if [ -n "$max_age_hours" ] && ! [[ "$max_age_hours" =~ ^[0-9]{1,4}$ ]]; then
  echo "backup-trigger: --max-age-hours는 정수다" >&2
  exit 64
fi
if ! [[ "$timeout_sec" =~ ^[0-9]{1,5}$ ]] || [ "$timeout_sec" -lt 1 ]; then
  echo "backup-trigger: --timeout은 1 이상 정수(초)다" >&2
  exit 64
fi

if [ -n "$max_age_hours" ]; then
  if last="$(mujoong_last_backup_epoch)"; then
    age=$(($(mujoong_epoch) - last))
    if [ "$age" -lt $((max_age_hours * 3600)) ]; then
      echo "backup-trigger: trigger=$trigger result=SKIPPED reason=recent ageSec=$age"
      exit 0
    fi
  fi
fi

rc=0
timeout "$timeout_sec" "$SCRIPT_DIR/mj" --release "$release" exec -T backup \
  /opt/mujoong/backup/backup.sh --trigger "$trigger" >/dev/null 2>&1 || rc=$?
case "$rc" in
  0) echo "backup-trigger: trigger=$trigger result=OK" ;;
  3) echo "backup-trigger: trigger=$trigger result=REFUSED reason=data_class" ;;
  124) echo "backup-trigger: trigger=$trigger result=FAIL reason=timeout" ;;
  *) echo "backup-trigger: trigger=$trigger result=FAIL reason=exit_$rc" ;;
esac
exit "$rc"
