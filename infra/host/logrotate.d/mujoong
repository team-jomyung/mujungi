# 무중 호스트 로그 회전 (U1 3.5 Step 47 · infra-spec 1.4 · 4.2 · monitoring 2.7.4 · cicd 2.3.3 · OD-14 · R4-11)
# 설치: /etc/logrotate.d/mujoong (root 0644). 디렉터리 /var/log/mujoong는 root 0755, 파일은 backup.log만 uid 999 640 · 나머지 root 640.
# archive/*.log.gz(배포 직전 로그 보존)는 배포 D9가 7일 또는 40개 초과분을 지운다(회전 대상이 아니다).

# 수집 파일: 매일 회전, 7개
/var/log/mujoong/host-collect.log /var/log/mujoong/metrics-snapshot.log {
    su root root
    daily
    rotate 7
    compress
    copytruncate
    missingok
    notifempty
}

# 사건 파일: 매일 회전, 30개(가용성 제외 구간이 11/2 보고 창보다 먼저 지워지지 않게)
/var/log/mujoong/deploy.log /var/log/mujoong/power.log /var/log/mujoong/backup.log {
    su root root
    daily
    rotate 30
    compress
    copytruncate
    missingok
    notifempty
}

# 배포 단위 로그: 마지막으로 쓴 지 30일이 지나면 지운다(minage 30 + rotate 0 + nocreate = 회전 즉시 삭제)
/var/log/mujoong/deploy-*.log /var/log/mujoong/migrate-*.log {
    su root root
    daily
    minage 30
    rotate 0
    nocreate
    nocompress
    missingok
    ifempty
}
