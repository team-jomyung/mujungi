# 무중 의도적 기동 · 정지 표시 단위 (U1 3.5 Step 47 · infra-spec 1.4 · 4.5.2 · N-9 · monitoring 2.6.3 · R4-7 · V-14)
# 설치: /etc/systemd/system/mujoong-power-mark.service (root 0644), `systemctl daemon-reload && systemctl enable mujoong-power-mark.service`
#
# mujoong-compose.service에 묶는다(R4-7, 수동 표시 없음):
#   - Requires · After: 스택 기동(oneshot, up --wait)이 끝난 뒤에만 시작해 POWER_READY를 쓴다. 스택 기동이 실패하면 시작하지 않는다
#     (POWER_STOP만 있고 POWER_READY가 없으면 가용성에서 빼지 않고 실패로 센다, monitoring 2.6.3)
#   - PartOf: `systemctl stop|restart mujoong-compose`(11/2 측정 창 단계 1 · 6)도 이 단위를 멈추고 다시 띄운다
#   - 정지 순서는 시작의 역순이라 호스트 종료 · 스택 정지 때 이 단위의 POWER_STOP이 스택 정지보다 먼저 기록된다(정지 시작 시점)
#   - WantedBy=mujoong-compose.service: 스택을 시작하면 이 단위도 함께 끌어온다(호스트 기동 완료 · 스택 시작 완료 모두 POWER_READY)

[Unit]
Description=Mujoong power marker (power.log POWER_READY / POWER_STOP)
Requires=mujoong-compose.service
After=mujoong-compose.service
PartOf=mujoong-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/mujoong/current/bin/power-mark POWER_READY
ExecStop=/opt/mujoong/current/bin/power-mark POWER_STOP

[Install]
WantedBy=multi-user.target mujoong-compose.service
